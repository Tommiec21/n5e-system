{
  "name": "n5e-system",
  "version": "0.27.0-alpha.2",
  "description": "N5e 4.0 game system for Foundry VTT v13",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "npm run lint && npm test && npm run test:core && npm run check",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "test:core": "node --import ./tests/core/setup.mjs --test \"tests/core/**/*.test.mjs\"",
    "lint": "eslint module n5e.mjs tools tests",
    "check": "node tools/check.mjs && node tools/check-core.mjs",
    "pack": "node tools/pack.mjs",
    "unpack": "node tools/unpack.mjs",
    "release": "node tools/release.mjs",
    "install-local": "node tools/install-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@foundryvtt/foundryvtt-cli": "^1.0.4",
    "archiver": "^7.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "handlebars": "^4.7.8"
  }
}
