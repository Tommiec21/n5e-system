<section class="tab n5e-tab combat {{tab.cssClass}}" data-tab="combat" data-group="primary">
  <div class="economy" aria-label="Action economy this turn">
    {{#each vm.economy}}
      <button type="button" class="eco {{key}} {{#if used}}used{{/if}}" data-action="toggleEconomy" data-key="{{key}}" aria-pressed="{{used}}"
        data-tooltip="{{#if used}}{{label}} used this turn (click to restore){{else}}{{label}} available (click to mark used){{/if}}" {{#unless @root.editable}}disabled{{/unless}}>
        {{{glyph}}} {{label}}</button>
    {{/each}}
    <span class="sub">Resets at the start of your turn</span>
  </div>
  <div class="trackers">
    {{#if vm.chain.show}}
    <div class="tracker chain">
      <div class="t-head"><h3>Chain</h3>
        <span class="boxes">{{#each vm.chain.boxes}}<button type="button" class="box {{#if filled}}on{{/if}}" data-action="setChain" data-value="{{n}}" aria-label="Chain {{n}}" {{#unless @root.editable}}disabled{{/unless}}></button>{{/each}}</span>
        <b class="big">{{vm.chain.value}}</b>
        {{#if editable}}<a class="ctl" data-action="resetChain" data-tooltip="Reset Chain" aria-label="Reset Chain"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}</div>
      {{#if vm.chain.atRank.length}}
        <p class="small">Chain {{vm.chain.value}} effects:
          {{#each vm.chain.atRank}}<a class="link n5e-row" data-item-id="{{id}}" data-action="useItem">{{name}}</a>{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{else if vm.chain.value}}<p class="small muted">No known jutsu has a Chain {{vm.chain.value}} effect.</p>{{/if}}
    </div>
    {{/if}}

    {{#if vm.concentration.show}}
    <div class="tracker conc {{#if vm.concentration.short}}short{{/if}}">
      <div class="t-head"><h3>Concentration</h3>
        <span class="slots">{{#each vm.concentration.slots}}<span class="pip {{#if filled}}on{{/if}}"></span>{{/each}}</span>
        <b class="big">{{vm.concentration.used}} / {{vm.concentration.max}}</b></div>
      {{#each vm.concentration.rows}}
        <div class="conc-row" data-item-id="{{id}}">
          <span class="rank">{{rank}}</span><a class="nm" data-action="editItem">{{name}}</a>
          {{#if efficient}}<span class="kw">Efficient</span>{{/if}}{{#if stable}}<span class="kw">Stable</span>{{/if}}
          <span class="upkeep" data-tooltip="Half of the {{paid}} CP paid when cast">{{upkeep}} CP</span>
          {{#if @root.editable}}<a class="ctl" data-action="toggleConcentration" aria-label="End concentration on {{name}}" data-tooltip="End (free)"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </div>
      {{else}}
        <p class="small muted">Not concentrating. Mark a concentration jutsu with its ◯ to track it.</p>
      {{/each}}
      <div class="t-foot">
        <span>Upkeep at turn start <b class="{{#if vm.concentration.short}}warn{{/if}}">{{vm.concentration.upkeep}} CP</b>
          {{#if vm.concentration.short}}<span class="warn">· not enough chakra</span>{{else}}{{#if vm.concentration.upkeep}}<span class="muted">· {{vm.concentration.cpAfter}} CP left</span>{{/if}}{{/if}}</span>
        <span class="rollable" data-action="roll" data-roll="skill" data-key="cha" data-tooltip="Click to roll Chakra Control. Con (Chakra Control) when you take damage: DC {{vm.concentration.dcBase}} + ranks of all concentrated jutsu, or half the damage if higher">Damage check <b>DC {{vm.concentration.dc}}</b></span>
      </div>
    </div>
    {{/if}}

    {{#if vm.stance.any}}
    <div class="tracker stance">
      <div class="t-head"><h3>Stance</h3><span class="sub">Switch: Bonus Action</span></div>
      {{#if vm.stance.active}}
        <div class="stance-active n5e-row" data-item-id="{{vm.stance.active.id}}" data-tooltip-html="{{vm.stance.active.tip}}">
          <b>{{vm.stance.active.name}}</b><span class="sub">{{vm.stance.active.categories}}</span>
          <button type="button" data-action="enterStance" {{#unless editable}}disabled{{/unless}}>Leave</button>
        </div>
        {{#if vm.stance.active.strikes}}<div class="pill-row n5e-row" data-item-id="{{vm.stance.active.id}}">
          <span class="act-pill action"><a class="pill-main" data-action="useItem" data-tooltip="Post the stance card with its strikes and abilities"><span class="nm">{{vm.stance.active.strikes}}</span></a></span></div>{{/if}}
      {{else}}<p class="small muted">{{#if vm.stance.any}}No stance active.{{else}}No stances known.{{/if}}</p>{{/if}}
      {{#if vm.stance.others.length}}
        <div class="pill-row">{{#each vm.stance.others}}
          <span class="act-pill bonus n5e-row" data-item-id="{{id}}" data-tooltip-html="{{tip}}"><a class="pill-main" data-action="enterStance"><span class="nm">{{name}}</span></a></span>
        {{/each}}</div>
      {{/if}}
    </div>
    {{/if}}

    {{#if vm.fury.show}}
    <div class="tracker fury {{#if vm.fury.value}}on{{/if}}">
      <div class="t-head"><h3>Fury</h3>
        <span class="boxes">{{#each vm.fury.boxes}}<span class="box {{#if filled}}on{{/if}}"></span>{{/each}}</span>
        <b class="big">{{vm.fury.value}}{{#if (n5eGt vm.fury.max 1)}} / {{vm.fury.max}}{{/if}}</b>
        {{#if editable}}<a class="ctl" data-action="changeFury" data-delta="1" data-tooltip="Gain Fury" aria-label="Gain Fury"><i class="fa-solid fa-plus"></i></a>
          <a class="ctl" data-action="changeFury" data-delta="-1" data-tooltip="Spend Fury" aria-label="Spend Fury"><i class="fa-solid fa-minus"></i></a>{{/if}}</div>
      <p class="small muted">Lasts until the end of the turn after gaining it.{{#if vm.fury.binding}} Binding Fury Stance: gained the first time each turn you roll weapon damage.{{/if}}</p>
    </div>
    {{/if}}

    {{#if vm.gates.show}}
    <div class="tracker gates {{#if vm.gates.open}}on{{/if}}">
      <div class="t-head"><h3>8-Inner Gates</h3>
        <span class="boxes">{{#each vm.gates.gates}}<span class="box {{#if on}}on{{/if}}" data-tooltip-html="{{tip}}">{{n}}</span>{{/each}}</span>
        <b class="big">{{#if vm.gates.open}}Gate {{vm.gates.open}}{{else}}Closed{{/if}}</b></div>
      {{#if editable}}<div class="t-foot">
        {{#if vm.gates.next}}<button type="button" data-action="openGate">Open Gate {{vm.gates.next.n}}: {{vm.gates.next.label}}</button>{{/if}}
        {{#if vm.gates.open}}<button type="button" data-action="closeGates">Close the gates</button>{{/if}}
      </div>{{/if}}
    </div>
    {{/if}}

    {{#if vm.marks.show}}
    <div class="tracker marks">
      <div class="t-head"><h3>Marks</h3><span class="sub">Target, then Mark (steps the ammo die down 1)</span></div>
      {{#each vm.marks.rows}}
        <div class="conc-row" data-item-id="{{id}}" data-tooltip-text="{{text}}">
          <span class="rank mark-{{color}}">●</span><span class="nm">{{label}} ({{name}})</span>
          {{#if @root.editable}}<button type="button" data-action="placeMark">Mark targets</button>{{/if}}
        </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if vm.amps.show}}
    <div class="tracker amps">
      <div class="t-head"><h3>Amps</h3>{{#if vm.amps.limit}}<span class="sub">{{vm.amps.limit}}</span>{{/if}}</div>
      {{#each vm.amps.rows}}
        <div class="conc-row {{#if disabled}}off{{/if}}" data-effect-id="{{id}}">
          <span class="rank">{{type}}</span><span class="nm">{{name}}</span><span class="upkeep">{{remaining}}</span>
          {{#if @root.editable}}<a class="ctl" data-action="toggleEffect" data-tooltip="{{#if disabled}}Make this the one that applies{{else}}Switch off{{/if}}"><i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>{{/if}}
        </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if vm.combo.show}}
    <div class="tracker combo ready">
      <div class="t-head"><h3>Finisher armed</h3>
        {{#if editable}}<a class="ctl" data-action="toggleCombo" data-tooltip="Clear" aria-label="Clear the armed Combo"><i class="fa-solid fa-xmark"></i></a>{{/if}}</div>
      <p class="small">Combo: <b>{{vm.combo.name}}</b>{{#if vm.combo.finishers.length}} → {{#each vm.combo.finishers}}<a class="link n5e-row" data-item-id="{{id}}" data-action="useItem">{{name}}</a>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</p>
    </div>
    {{/if}}
  </div>

  <div class="act-group basic">
    <div class="section-head"><h2>{{vm.basic.label}}</h2></div>
    {{#each vm.basic.sections}}
      <div class="act-row"><span class="row-lbl">{{label}}</span>
        <div class="pills">{{#each pills}}{{> "systems/n5e/templates/parts/action-pill.hbs"}}{{/each}}</div></div>
    {{/each}}
  </div>

  {{#each vm.jutsu}}
    <div class="act-group {{key}}">
      <div class="section-head"><h2>{{label}}</h2><span class="sub">{{sub}}</span></div>
      {{#each rows}}
        <div class="act-row"><span class="row-lbl">{{label}}</span>
          <div class="pills">{{#each pills}}{{> "systems/n5e/templates/parts/action-pill.hbs"}}{{/each}}</div></div>
      {{else}}
        <p class="small muted">No {{label}} known.</p>
      {{/each}}
    </div>
  {{/each}}

  {{#if vm.skills.rows.length}}
    <div class="act-group skills">
      <div class="section-head"><h2>{{vm.skills.label}}</h2></div>
      {{#each vm.skills.rows}}
        <div class="act-row"><span class="row-lbl">{{label}}</span>
          <div class="pills">{{#each pills}}{{> "systems/n5e/templates/parts/action-pill.hbs"}}{{/each}}</div></div>
      {{/each}}
    </div>
  {{/if}}
</section>
