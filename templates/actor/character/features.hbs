<section class="tab n5e-tab features {{tab.cssClass}}" data-tab="features" data-group="primary">
  {{#unless isNPC}}
  <div class="origins compact">
    {{#with vm.classCard}}
      <div class="origin cls n5e-row" data-item-id="{{id}}" data-tooltip="{{hitDie}} HP · {{chakraDie}} CP · {{tier}} jutsu tier">
        <span class="lbl">Class</span><a class="title" data-action="editItem">{{name}} {{levels}}</a>
        {{#if subclass}}<span class="sub">{{subclass}}</span>{{/if}}
        {{#if @root.editMode}}<input type="number" min="1" max="20" value="{{levels}}" data-item-field="system.levels" aria-label="Class level">{{/if}}
      </div>
    {{else}}
      <div class="origin empty">Drop a class</div>
    {{/with}}
    {{#with vm.clanCard}}
      <div class="origin n5e-row" data-item-id="{{id}}">
        <span class="lbl">Clan</span><a class="title" data-action="editItem">{{name}}</a>
        {{#if affinities}}<span class="sub">{{affinities}}</span>{{/if}}
      </div>
    {{else}}
      <div class="origin empty">Drop a clan</div>
    {{/with}}
    {{#with vm.backgroundCard}}
      <div class="origin n5e-row" data-item-id="{{id}}"><span class="lbl">Background</span><a class="title" data-action="editItem">{{name}}</a></div>
    {{else}}
      <div class="origin empty">Drop a background</div>
    {{/with}}
  </div>
  {{/unless}}

  {{#each vm.groups}}
    <div class="feature-group {{key}}">
      <div class="section-head"><h2>{{label}}</h2>
        {{#if clan}}{{#with @root.vm.clanCard}}{{#if hijutsu.length}}
          <label class="hijutsu" data-item-id="{{id}}" data-tooltip="Hijutsu Flexibility: which ability your Hijutsu use">Hijutsu ability
            <select data-item-field="system.hijutsuChoice" {{#unless @root.editable}}disabled{{/unless}}>
              <option value="" {{#unless hijutsuChoice}}selected{{/unless}}>Auto (higher)</option>
              {{#each hijutsu}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        {{/if}}{{/with}}{{/if}}
      </div>
      {{#each subgroups}}
        {{#if label}}<h3 class="sub-head">{{label}}</h3>{{/if}}
        {{#each rows}}
          <div class="n5e-row feature-row draggable" data-item-id="{{id}}" draggable="true">
            <span class="lvl">{{#if level}}Lv {{level}}{{/if}}</span>
            <span class="glyph">{{{glyph}}}</span>
            <a class="name" data-action="editItem">{{name}}</a>
            {{#if uses}}<span class="sub">{{uses}}</span>{{/if}}
            {{#if choice}}<select class="choice" data-item-field="flags.n5e.choice.value" aria-label="{{choice.label}}" data-tooltip="{{choice.label}}" {{#unless @root.editable}}disabled{{/unless}}>
              <option value="" {{#if choice.none}}selected{{/if}}>{{choice.label}}…</option>
              {{#each choice.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
            <span class="use">{{#unless passive}}<button type="button" data-action="useItem">Use</button>{{/unless}}{{> "systems/n5e/templates/parts/item-controls.hbs"}}</span>
          </div>
        {{else}}
          <p class="muted small">None yet.</p>
        {{/each}}
      {{/each}}
    </div>
  {{/each}}

  <div class="stances">
    <div class="section-head"><h2>Stances</h2><span class="sub">One at a time · switching costs a Bonus Action</span></div>
    {{#each vm.stances}}
      <div class="n5e-row stance-row {{#if active}}active{{/if}}" data-item-id="{{id}}">
        <a class="name" data-action="editItem">{{name}}</a><span class="sub">{{categories}}</span>
        <button type="button" data-action="enterStance" {{#unless @root.editable}}disabled{{/unless}}>{{#if active}}Leave{{else}}Enter{{/if}}</button>
      </div>
    {{else}}
      <p class="muted small">No stances.</p>
    {{/each}}
  </div>
</section>
