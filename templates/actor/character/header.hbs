<header class="n5e-head">
  <div class="identity">
    <div class="name-row">
      {{#if editMode}}
        <input class="name-input" type="text" name="name" value="{{vm.name}}" aria-label="Name">
      {{else}}
        <h1 class="name">{{vm.name}}</h1>
      {{/if}}
      <span class="level">Level {{vm.level}}</span>
    </div>
    <div class="bubbles">
      {{#each vm.origins}}
        {{#if empty}}
          <div class="bubble empty" data-origin="{{kind}}"><span class="lbl">{{label}}</span><b>{{name}}</b></div>
        {{else}}
          <div class="bubble n5e-row {{kind}}" data-item-id="{{id}}" data-action="editItem" data-tooltip="Open {{label}}">
            <img src="{{img}}" alt="" width="34" height="34">
            <span class="txt"><b>{{name}}</b><span class="sub">{{sub}}</span></span>
          </div>
        {{/if}}
      {{/each}}
    </div>
    <div class="xp">
      <span class="lbl">XP</span>
      <span class="bar"><span class="fill" style="width: {{vm.xp.pct}}%"></span></span>
      {{#if editMode}}
        <input type="number" name="system.details.xp" value="{{vm.xp.value}}" aria-label="Experience">
      {{else}}
        <span class="val">{{vm.xp.value}}{{#if vm.xp.next}} / {{vm.xp.next}}{{/if}}</span>
      {{/if}}
    </div>
  </div>
  <div class="head-right">
    <div class="buttons">
      {{#if editable}}{{#if vm.canLevelUp}}
        <button type="button" class="level-up" data-action="levelUp" data-class-id="{{vm.classId}}" data-tooltip="Gain level {{vm.nextLevel}}"><i class="fa-solid fa-arrow-up"></i> Level Up</button>
      {{/if}}{{#if editMode}}{{#if vm.classId}}
        <button type="button" data-action="levelDown" data-class-id="{{vm.classId}}" data-tooltip="Remove the highest level and what it granted"><i class="fa-solid fa-arrow-down"></i></button>
      {{/if}}{{/if}}{{/if}}
      <button type="button" class="rest" disabled data-tooltip="Rest dialogs arrive in Phase 5">Short Rest</button>
      <button type="button" class="rest" disabled data-tooltip="Rest dialogs arrive in Phase 5">Long Rest</button>
      <button type="button" class="rest" disabled data-tooltip="Rest dialogs arrive in Phase 5">Full Rest</button>
      {{#if editable}}
        <button type="button" class="mode {{#if editMode}}on{{/if}}" data-action="toggleMode" aria-pressed="{{editMode}}"
          data-tooltip="{{#if editMode}}Back to play mode{{else}}Edit mode{{/if}}" aria-label="Toggle edit mode"><i class="fa-solid fa-pen"></i></button>
      {{/if}}
    </div>
    <div class="ability-strip">
      {{#each vm.abilities}}
        <div class="ab-tile" data-tooltip="{{label}}">
          <span class="abbr">{{abbr}}</span>
          <b class="mod rollable" data-action="roll" data-roll="ability" data-key="{{key}}" data-tooltip="Roll {{label}} check (Shift: options, Alt: advantage, Ctrl: disadvantage)">{{mod}}</b>
          {{#if @root.editMode}}
            <input type="number" name="system.abilities.{{key}}.value" value="{{value}}" min="0" max="30" aria-label="{{label}} score">
          {{else}}
            <span class="score">{{value}}</span>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
</header>
