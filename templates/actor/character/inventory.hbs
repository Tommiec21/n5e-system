{{!-- Inventory tab. Data: vm = inventoryVM(actor). The Ammunition Die control: left click down (data-action="ammoDown"), right click up (listener in _onRender). --}}
<section class="tab n5e-tab inventory {{tab.cssClass}}" data-tab="inventory" data-group="primary">
  <div class="slots" data-tooltip-html="{{vm.slotsTip}}">
    <div class="line"><b>Inventory Slots</b><span><b>{{vm.used}}</b> / {{vm.slots}}{{#if vm.encumbered}} · <span class="warn">Encumbered (half speed)</span>{{/if}}</span></div>
    <div class="meter-cells">{{#each vm.meter}}<span class="cell {{#if filled}}on{{/if}} {{#if over}}over{{/if}}"></span>{{/each}}</div>
  </div>

  {{#each vm.sections}}
    {{#unless empty}}
      <div class="inv-section">
        <div class="section-head"><h2>{{label}}</h2></div>
        <ol class="rows">
          {{#each rows}}
            <li class="n5e-row gear-row draggable" data-item-id="{{id}}" draggable="true">
              <img src="{{img}}" alt="" width="32" height="32">
              <div class="name-col">
                <a class="name" data-action="editItem">{{name}}{{#if (n5eGt quantity 1)}} ×{{quantity}}{{/if}}</a>
                <span class="sub">{{subtitle}}</span>
                {{#if chips.length}}{{> "systems/n5e/templates/parts/chips.hbs" chips=chips}}{{/if}}
              </div>
              <div class="extras">
                {{#if seals}}<span class="sub" data-tooltip-text="Seal slots used">Seals {{seals.used}} / {{seals.max}}</span>{{/if}}
                {{#if ammo}}
                  <span class="ammo"><span class="lbl">Ammunition Die</span>
                    <button type="button" class="ammo-die" data-action="ammoDown" data-ammo-die {{#unless @root.editable}}disabled{{/unless}}
                      data-tooltip="Left click: step down after a roll of 1-2 · Right click: step up when you recover ammo ({{ammo.ladder}}). Reaching 0 removes it."
                      aria-label="Ammunition Die {{ammo.label}}">{{ammo.label}}</button></span>
                {{/if}}
                {{#if charges}}
                  <span class="charges" aria-label="Charges">{{#each charges}}<button type="button" class="pip {{#if filled}}on{{/if}}" data-action="setCharge" data-idx="{{idx}}" aria-label="Charge {{n}}" {{#unless @root.editable}}disabled{{/unless}}></button>{{/each}}</span>
                {{/if}}
              </div>
              <span class="bulk">Bulk {{bulk}}</span>
              <span class="use">
                {{#if equippable}}
                  <button type="button" class="equip {{#if equipped}}on{{/if}}" data-action="toggleEquip" aria-pressed="{{equipped}}">{{#if equipped}}Equipped{{else}}Equip{{/if}}</button>
                {{else}}
                  <button type="button" data-action="useItem">Use</button>
                {{/if}}
                {{> "systems/n5e/templates/parts/item-controls.hbs"}}
              </span>
            </li>
          {{/each}}
        </ol>
      </div>
    {{/unless}}
  {{/each}}

  <div class="ryo"><b>Ryo</b>
    {{#if editable}}<input type="number" name="system.currency.ryo" value="{{vm.ryo}}" min="0" aria-label="Ryo">{{else}}{{vm.ryo}}{{/if}}
  </div>
</section>
