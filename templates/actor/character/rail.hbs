<aside class="n5e-rail">
  <div class="portrait-wrap">
    <img class="portrait" src="{{vm.img}}" alt="{{vm.name}}" {{#if editable}}data-action="editImage" data-tooltip="Change portrait"{{/if}}>
    <span class="level-badge" data-tooltip="Level">{{vm.level}}</span>
  </div>

  <div class="stat-strip">
    <div class="st" data-tooltip-html="{{vm.ac.tip}}" data-tooltip-direction="RIGHT"><span class="lbl">AC</span><b>{{vm.ac.value}}</b></div>
    <div class="st" data-tooltip-html="{{vm.speed.tip}}" data-tooltip-direction="RIGHT"><span class="lbl">SPD</span><b class="{{#if vm.speed.halved}}warn{{/if}}">{{vm.speed.value}}</b></div>
    <div class="st rollable" data-action="rollInit" data-tooltip-html="{{vm.initiative.tip}}" data-tooltip-direction="RIGHT"><span class="lbl">Init</span><b>{{vm.initiative.value}}</b></div>
    <div class="st" data-tooltip-html="{{vm.profTip}}" data-tooltip-direction="RIGHT"><span class="lbl">Prof</span><b>{{vm.prof}}</b></div>
    <div class="st" data-tooltip-html="{{vm.dr.tip}}" data-tooltip-direction="RIGHT"><span class="lbl">DR</span><b>{{vm.dr.value}}</b></div>
  </div>

  <div class="meter hp" data-tooltip-html="{{vm.hp.tip}}" data-tooltip-direction="RIGHT">
    <div class="meter-head"><span>Hit Points</span>
      <span><input type="number" name="system.hp.value" value="{{vm.hp.value}}" aria-label="Current HP" {{#unless editable}}disabled{{/unless}}> / {{vm.hp.max}}</span></div>
    <div class="track"><div class="fill" style="width: {{vm.hp.pct}}%"></div></div>
    <div class="meter-foot"><label>Temp <input type="number" name="system.hp.temp" value="{{vm.hp.temp}}" {{#unless editable}}disabled{{/unless}}></label>
      <span class="{{#if vm.hp.bloodied}}warn{{/if}}">{{#if vm.hp.bloodied}}Bloodied{{else}}Bloodied at {{vm.hp.bloodiedAt}}{{/if}}</span></div>
  </div>
  <div class="meter cp" data-tooltip-html="{{vm.cp.tip}}" data-tooltip-direction="RIGHT">
    <div class="meter-head"><span>Chakra Points</span>
      <span><input type="number" name="system.cp.value" value="{{vm.cp.value}}" aria-label="Current CP" {{#unless editable}}disabled{{/unless}}> / {{vm.cp.max}}</span></div>
    <div class="track"><div class="fill" style="width: {{vm.cp.pct}}%"></div></div>
    <div class="meter-foot"><label>Temp <input type="number" name="system.cp.temp" value="{{vm.cp.temp}}" {{#unless editable}}disabled{{/unless}}></label>
      <span class="{{#if vm.cp.drained}}warn{{/if}}">{{#if vm.cp.drained}}Drained{{else}}Drained at {{vm.cp.drainedAt}}{{/if}}</span></div>
  </div>
  <div class="dice-row">
    <span class="die hd" data-tooltip="Hit Dice: {{vm.hitDice.value}} of {{vm.hitDice.max}} {{vm.hitDice.die}} left (spend on a short rest)" data-tooltip-direction="RIGHT">
      <span class="lbl">HD</span> <b>{{vm.hitDice.value}}/{{vm.hitDice.max}}</b> <span class="sub">{{vm.hitDice.die}}</span></span>
    <span class="die cd" data-tooltip="Chakra Dice: {{vm.chakraDice.value}} of {{vm.chakraDice.max}} {{vm.chakraDice.die}} left (spend on a short rest)" data-tooltip-direction="RIGHT">
      <span class="lbl">CD</span> <b>{{vm.chakraDice.value}}/{{vm.chakraDice.max}}</b> <span class="sub">{{vm.chakraDice.die}}</span></span>
  </div>

  <div class="block resources">
    <h3>Resources</h3>
    {{#each vm.resources}}
      <div class="resource {{kind}}" data-pool="{{id}}" {{#if itemId}}data-item-id="{{itemId}}"{{/if}}>
        <div class="meter-head"><b>{{label}}</b><span>{{value}} / {{max}}</span></div>
        {{#if segments}}
          <div class="segments">
            {{#each segments}}<button type="button" class="seg {{#if filled}}on{{/if}}" data-action="{{../action}}" data-value="{{n}}" aria-label="{{../label}} {{n}}" {{#unless @root.editable}}disabled{{/unless}}></button>{{/each}}
          </div>
        {{else}}
          <div class="track thin"><div class="fill" style="width: {{pct}}%"></div></div>
        {{/if}}
        {{#if note}}<div class="sub">{{note}}</div>{{/if}}
      </div>
    {{/each}}
  </div>

  <div class="block conditions">
    <div class="line"><h3>Conditions</h3>
      {{#if editable}}
        <select data-add-condition aria-label="Add a condition">
          <option value="">+ Add</option>
          {{#each conditionChoices}}<option value="{{key}}">{{label}}</option>{{/each}}
        </select>
      {{/if}}
    </div>
    {{#each vm.conditions}}
      <div class="condition {{#if disabled}}off{{/if}}" data-effect-id="{{id}}" data-tooltip-text="{{summary}}" data-tooltip-direction="RIGHT">
        <span class="name">{{label}}</span>
        {{#if ranked}}
          <span class="ranks">
            {{#if @root.editable}}<a class="ctl" data-action="changeRanks" data-delta="-1" aria-label="Lower rank">−</a>{{/if}}
            {{#each pips}}<span class="pip {{#if filled}}on{{/if}}"></span>{{/each}}
            <span class="num">{{ranks}}/{{max}}</span>
            {{#if @root.editable}}<a class="ctl" data-action="changeRanks" data-delta="1" aria-label="Raise rank">+</a>{{/if}}
          </span>
        {{else if @root.editable}}
          <a class="ctl" data-action="deleteEffect" aria-label="Remove {{label}}"><i class="fa-solid fa-xmark"></i></a>
        {{/if}}
      </div>
    {{else}}
      <p class="muted small">No conditions.</p>
    {{/each}}
  </div>
</aside>
