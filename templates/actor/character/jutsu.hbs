{{!-- Jutsu tab. Data: vm = jutsuVM(actor, sheet state). The search box re-renders only this part (character-sheet.mjs _onRender). Keep rows one line (King). --}}
<section class="tab n5e-tab jutsu {{tab.cssClass}}" data-tab="jutsu" data-group="primary">
  {{#if npcLines}}{{> "systems/n5e/templates/actor/npc/casting-lines.hbs" block=npcLines which="jutsu"}}{{/if}}
  <div class="toolbar">
    <label class="search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" data-jutsu-search value="{{vm.search}}" placeholder="Search jutsu or keyword" aria-label="Search jutsu"></label>
    {{#each vm.filters}}
      <button type="button" class="filter {{#if active}}on{{/if}}" data-action="jutsuFilter" data-discipline="{{key}}">{{label}}</button>
    {{/each}}
    <button type="button" class="filter" data-action="openBrowser" data-browser-tab="jutsu" data-tooltip="Open the Compendium Browser"><i class="fa-solid fa-book-open"></i> Browse</button>
    <span class="view-toggle" role="group" aria-label="Jutsu view">
      <button type="button" class="filter {{#unless vm.pills}}on{{/unless}}" data-action="jutsuView" data-view="rows" data-tooltip="Rows: every detail on one line" aria-pressed="{{#if vm.pills}}false{{else}}true{{/if}}"><i class="fa-solid fa-list"></i></button>
      <button type="button" class="filter {{#if vm.pills}}on{{/if}}" data-action="jutsuView" data-view="pills" data-tooltip="Pills: name and cost; hover for details" aria-pressed="{{#if vm.pills}}true{{else}}false{{/if}}"><i class="fa-solid fa-grip"></i></button>
    </span>
  </div>
  <div class="strip">
    <span data-tooltip="Class jutsu: count toward your class's Jutsu Known"><b>Class</b> {{vm.known}}{{#if vm.knownMax}} / {{vm.knownMax}}{{/if}}</span>
    {{#if vm.bonus.max}}<span data-tooltip="{{vm.bonus.tip}}"><b>Bonus</b> {{vm.bonus.used}} / {{vm.bonus.max}}</span>{{else if vm.bonus.used}}<span data-tooltip="Bonus Jutsu with no feature giving slots"><b>Bonus</b> {{vm.bonus.used}}</span>{{/if}}
    {{#if vm.openSlots}}<button type="button" class="filter on" data-action="openBrowser" data-browser-tab="jutsu" data-learn="1" data-tooltip="Open the Jutsu Browser to fill your open slots"><i class="fa-solid fa-graduation-cap"></i> Jutsu to learn: {{vm.openSlots}}</button>{{/if}}
    <span><b>Highest rank</b> {{vm.maxRank}}</span>
    <span><b>Concentrating</b> {{#if vm.concentrating.length}}{{#each vm.concentrating}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}nothing{{/if}} ({{vm.concentrating.length}} / {{vm.concentrationMax}})</span>
  </div>

  <div class="n5e-jutsu-list">
    {{#if vm.empty}}
      <div class="empty-state"><p>No jutsu yet. Drag jutsu here from the Jutsu compendium or the Browse button.</p></div>
    {{else if vm.noMatches}}
      <div class="empty-state"><p>No jutsu match this filter.</p></div>
    {{/if}}
    {{#each vm.groups}}
      <div class="discipline-group">
        <div class="section-head"><h2>{{label}}</h2>
          <span class="sub">Attack <b data-tooltip-html="{{attackTip}}">{{attack}}</b> · Save DC <b data-tooltip-html="{{dcTip}}">{{dc}}</b> · {{ability}}</span></div>
        {{#each ranks}}
          <div class="rank-head"><span>{{label}}</span></div>
          {{#if @root.vm.pills}}
          <div class="jutsu-pills">
            {{#each rows}}
              <span class="act-pill jutsu-pill n5e-row draggable {{#if missingAccess}}dim{{/if}}" data-item-id="{{id}}" draggable="true" data-tooltip-html="{{pillTip}}" data-tooltip-direction="UP">
                <a class="pill-main" data-action="jutsuDetails">{{{glyph}}}<span class="nm">{{name}}</span>{{#unless (n5eEq costMode "none")}}<span class="cost">{{cost}} CP</span>{{/unless}}{{#if hit}}<span class="sub">{{hit}}</span>{{else if dc}}<span class="sub">DC {{dc}}</span>{{/if}}</a>
              </span>
            {{/each}}
          </div>
          {{else}}
          <ol class="rows">
            {{#each rows}}
              <li class="n5e-row jutsu-row draggable {{#if open}}open{{/if}} {{#if missingAccess}}locked{{/if}}" data-item-id="{{id}}" draggable="true">
                <div class="row-main">
                  <span class="glyph" data-tooltip-text="{{glyphLabel}}">{{{glyph}}}</span>
                  <a class="name" data-action="toggleExpand" data-tooltip="Show details">{{name}}</a>
                  <span class="tags">
                    {{#each chips}}<span class="chip {{tone}}" data-tooltip-html="{{tooltip}}">{{label}}</span>{{/each}}
                    {{#if concentration}}<span class="chip conc" data-tooltip="Concentration">Conc.</span>{{/if}}
                    {{#if components}}<span class="chip comp" data-tooltip-html="{{components.tooltip}}">{{components.label}}</span>{{/if}}
                    {{#if upcastTo}}<span class="chip upcast" data-tooltip="Can be cast up to {{upcastTo}}-Rank">↑{{upcastTo}}</span>{{/if}}
                    {{#if unmetRequirement}}<span class="chip warn">{{unmetRequirement}}</span>{{/if}}
                    {{#if missingAccess}}<span class="chip warn">No affinity</span>{{/if}}
                  </span>
                  <span class="range" data-tooltip="Range{{#if area}} · Area {{area}}{{/if}}">{{range}}{{#if area}} · {{area}}{{/if}}</span>
                  <span class="cost" data-tooltip="Chakra cost">{{#if (n5eEq costMode "none")}}—{{else}}{{cost}} CP{{/if}}</span>
                  <span class="hit" data-tooltip="Attack or save DC">{{#if hit}}{{hit}}{{else if dc}}DC {{dc}}{{else}}—{{/if}}</span>
                  <span class="use">
                    <button type="button" data-action="jutsuDetails">Use</button>
                    {{> "systems/n5e/templates/parts/item-controls.hbs"}}
                  </span>
                </div>
                {{#if detail}}
                  <div class="row-detail">
                    <div class="meta"><span><b>Duration</b> {{detail.duration}}</span>
                      {{#if (n5eGt detail.ranks.length 1)}}
                        <span class="cast-ranks"><b>Cast at</b>
                          {{#each detail.ranks}}<button type="button" class="{{#if selected}}on{{/if}}" data-action="castRank" data-rank="{{rank}}">{{rank}} · {{cost}} CP</button>{{/each}}
                        </span>
                      {{/if}}
                    </div>
                    <div class="desc">{{{detail.description}}}</div>
                    {{#each detail.chain}}<div class="rider"><b>Chain {{n}}</b>{{{text}}}</div>{{/each}}
                    {{#if detail.finisher}}<div class="rider accent"><b>Finisher</b>{{{detail.finisher}}}</div>{{/if}}
                    {{#if detail.overcharge}}<div class="rider"><b>Overcharge</b>{{{detail.overcharge}}}</div>{{/if}}
                    {{#if detail.upcast}}<div class="rider muted"><b>At higher ranks</b>{{{detail.upcast}}}</div>{{/if}}
                  </div>
                {{/if}}
              </li>
            {{/each}}
          </ol>
          {{/if}}
        {{/each}}
      </div>
    {{/each}}
  </div>
</section>
