{{!-- SHEETS1 shared: level up/down, Level History (LVL1 L5), rests and the edit toggle. h = headerVM. Each button has an icon and a label; a design shows either. --}}
<div class="d-head-buttons">
  {{#if @root.editable}}{{#if h.canLevelUp}}
    <button type="button" class="d-btn level-up" data-action="levelUp" data-class-id="{{h.classId}}" data-tooltip="Gain level {{h.nextLevel}}"><i class="fa-solid fa-arrow-up"></i><span class="txt">Level Up</span></button>
  {{/if}}{{#if h.classId}}
    <button type="button" class="d-btn level-history" data-action="levelHistory" data-class-id="{{h.classId}}" data-tooltip="Level History: what each level gave; change a past level's choices" aria-label="Level History"><i class="fa-solid fa-clock-rotate-left"></i><span class="txt">History</span></button>
  {{/if}}{{#if @root.editMode}}{{#if h.classId}}
    <button type="button" class="d-btn" data-action="levelDown" data-class-id="{{h.classId}}" data-tooltip="Remove the highest level and what it granted" aria-label="Level down"><i class="fa-solid fa-arrow-down"></i></button>
  {{/if}}{{/if}}{{/if}}
  {{#if @root.editable}}
    <button type="button" class="d-btn rest short" data-action="rest" data-rest="short" data-tooltip="Short rest: 1 hour, spend Hit and Chakra Dice" aria-label="Short rest"><i class="fa-solid fa-utensils"></i><span class="txt">Short Rest</span></button>
    <button type="button" class="d-btn rest long" data-action="rest" data-rest="long" data-tooltip="Long rest: 8 hours, half HP and CP, half spent dice" aria-label="Long rest"><i class="fa-solid fa-campground"></i><span class="txt">Long Rest</span></button>
    <button type="button" class="d-btn rest full" data-action="rest" data-rest="full" data-tooltip="Full rest: 24 hours, everything back, persisting conditions end" aria-label="Full rest"><i class="fa-solid fa-bed"></i><span class="txt">Full Rest</span></button>
    <button type="button" class="d-btn mode {{#if @root.editMode}}on{{/if}}" data-action="toggleMode" aria-pressed="{{@root.editMode}}"
      data-tooltip="{{#if @root.editMode}}Back to play mode{{else}}Edit mode{{/if}}" aria-label="Toggle edit mode"><i class="fa-solid fa-pen"></i><span class="txt">{{#if @root.editMode}}Editing{{else}}Play{{/if}}</span></button>
  {{/if}}
</div>
