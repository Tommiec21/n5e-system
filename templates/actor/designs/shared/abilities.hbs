{{!-- SHEETS1 shared: the six ability scores (roll the check; edit mode edits the score). h = headerVM. --}}
<div class="d-abilities">
  {{#each h.abilities}}
    <div class="d-ab" data-key="{{key}}">
      <span class="abbr" data-tooltip="{{label}}">{{abbr}}</span>
      <b class="mod rollable" data-action="roll" data-roll="ability" data-key="{{key}}" data-tooltip="Roll {{label}} check (Shift: options, Alt: advantage, Ctrl: disadvantage)">{{mod}}</b>
      {{#if @root.editMode}}
        <input class="score" type="number" name="system.abilities.{{key}}.value" value="{{value}}" min="0" max="30" aria-label="{{label}} score">
      {{else}}
        <span class="score">{{value}}</span>
      {{/if}}
    </div>
  {{/each}}
</div>
