{{!-- NPC Notes tab (replaces Biography on NPC sheets). Data: notes = {publicHTML, privateHTML, biographyHTML, public, private, biography, isGM}. Private notes are shown to GMs only. --}}
<section class="tab n5e-tab biography npc-notes {{tab.cssClass}}" data-tab="biography" data-group="primary">
  <div class="section-head"><h2>Public notes</h2></div>
  {{#if editMode}}<textarea name="system.details.publicNotes" rows="6" aria-label="Public notes">{{notes.public}}</textarea>{{else}}<div class="bio-text">{{{notes.publicHTML}}}</div>{{/if}}
  {{#if notes.isGM}}
    <div class="section-head"><h2>Private notes</h2><span class="budget">GM only</span></div>
    {{#if editMode}}<textarea name="system.details.privateNotes" rows="6" aria-label="Private notes">{{notes.private}}</textarea>{{else}}<div class="bio-text">{{{notes.privateHTML}}}</div>{{/if}}
  {{/if}}
  <div class="section-head"><h2>Biography</h2></div>
  {{#if editMode}}<textarea name="system.details.biography" rows="8" aria-label="Biography">{{notes.biography}}</textarea>{{else}}<div class="bio-text">{{{notes.biographyHTML}}}</div>{{/if}}
  {{#if editMode}}
    <details class="all-fields"><summary>All stored fields (advanced)</summary>
      {{> "systems/n5e/templates/parts/field-rows.hbs" rows=rows editable=editable}}
    </details>
  {{/if}}
</section>
