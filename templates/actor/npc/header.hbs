{{!-- NPC header (NPCUI1): identity and live trackers only; no number the Stat Block repeats. Data: head = npcSheetHeaderVM(actor), conditionChoices. --}}
<header class="n5e-head npc-head2">
  <div class="npc-id">
    <img class="npc-token" src="{{head.img}}" alt="" width="56" height="56" {{#if editable}}data-action="editImage" data-tooltip="Change portrait"{{/if}}>
    <div class="npc-names">
      <div class="npc-title"><h1 class="name">{{head.name}}</h1><span class="npc-summary">{{head.summary}}</span></div>
      {{#if head.blurb}}<div class="npc-blurb">{{head.blurb}}</div>{{/if}}
    </div>
    {{#if editable}}
      <div class="buttons">
        <button type="button" class="rest" data-action="rest" data-rest="short" data-tooltip="1 hour">Short Rest</button>
        <button type="button" class="rest" data-action="rest" data-rest="long" data-tooltip="8 hours">Long Rest</button>
        <button type="button" class="mode {{#if editMode}}on{{/if}}" data-action="toggleMode" aria-pressed="{{editMode}}"
          data-tooltip="{{#if editMode}}Back to play mode{{else}}Edit mode (notes, items){{/if}}" aria-label="Toggle edit mode"><i class="fa-solid fa-pen"></i></button>
      </div>
    {{/if}}
  </div>
  <div class="npc-trackers">
    <div class="trk hp" data-tooltip-html="{{head.hp.tip}}">
      <div class="trk-head"><span class="lbl">Hit Points</span>{{#if head.hp.bloodied}}<span class="state">Bloodied</span>{{/if}}</div>
      <div class="trk-val"><input type="number" name="system.hp.value" value="{{head.hp.value}}" aria-label="Current HP" {{#unless editable}}disabled{{/unless}}><span>/ {{head.hp.max}}</span>
        <label class="temp">temp <input type="number" name="system.hp.temp" value="{{head.hp.temp}}" aria-label="Temporary HP" {{#unless editable}}disabled{{/unless}}></label></div>
      <div class="track"><div class="fill" style="width: {{head.hp.pct}}%"></div></div>
    </div>
    <div class="trk cp" data-tooltip-html="{{head.cp.tip}}">
      <div class="trk-head"><span class="lbl">Chakra</span>{{#if head.cp.drained}}<span class="state">Drained</span>{{/if}}</div>
      {{#if head.noChakra}}<div class="trk-val"><span>none</span></div>{{else}}
      <div class="trk-val"><input type="number" name="system.cp.value" value="{{head.cp.value}}" aria-label="Current CP" {{#unless editable}}disabled{{/unless}}><span>/ {{head.cp.max}}</span>
        <label class="temp">temp <input type="number" name="system.cp.temp" value="{{head.cp.temp}}" aria-label="Temporary CP" {{#unless editable}}disabled{{/unless}}></label></div>
      <div class="track"><div class="fill" style="width: {{head.cp.pct}}%"></div></div>{{/if}}
    </div>
    <div class="trk conds">
      <div class="trk-head"><span class="lbl">Conditions</span>
        {{#if editable}}<select data-add-condition aria-label="Add a condition"><option value="">+ Add</option>{{#each conditionChoices}}<option value="{{key}}">{{label}}</option>{{/each}}</select>{{/if}}</div>
      <div class="chips">
        {{#each head.conditions}}
          <span class="cond {{#if disabled}}off{{/if}}" data-effect-id="{{id}}" data-tooltip-text="{{summary}}">{{label}}{{#if ranked}} {{ranks}}{{/if}}
            {{#if @root.editable}}{{#if ranked}}<a class="ctl" data-action="changeRanks" data-delta="-1" aria-label="Lower rank">−</a><a class="ctl" data-action="changeRanks" data-delta="1" aria-label="Raise rank">+</a>{{else}}<a class="ctl" data-action="deleteEffect" aria-label="Remove {{label}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}{{/if}}
          </span>
        {{else}}<span class="muted small">None</span>{{/each}}
      </div>
    </div>
  </div>
</header>
