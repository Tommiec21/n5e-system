{{!-- Build tab (NPC1b, NPC1c). Data: vm = npcBuildVM(actor), defenses = npcDefensesVM(actor), knowledge = npcKnowledgeVM(actor). The profile gives every number (rules/adversary.mjs); each can be overridden here. Blank override = the computed number. --}}
<section class="tab n5e-tab npc-build {{tab.cssClass}}" data-tab="build" data-group="primary">
  <div class="section-head"><h2>Identity</h2></div>
  <div class="build-grid">
    <label>Name <input type="text" name="name" value="{{actor.name}}"></label>
    <label class="wide">Blurb <input type="text" name="system.details.blurb" value="{{npc.blurb}}" placeholder="One line under the name"></label>
    <label>Type <input type="text" name="system.details.creatureType" value="{{npc.creatureType}}"></label>
    <label>Template <select name="system.details.template">{{#each npc.templateOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <span class="hint">Size, speeds, senses and languages: Defenses, senses and movement below.</span>
  </div>
  {{#unless npc.isAdversary}}
    <div class="section-head"><h2>Player-style numbers</h2></div>
    <div class="build-grid">
      <label>Level <input type="number" name="system.details.level" value="{{npc.level}}" min="0" max="30"></label>
      <label>Rank <select name="system.details.rank">{{#each npc.rankOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label data-tooltip="Blank = from level and Hit Die">HP max <input type="number" name="system.hpMax" value="{{npc.hpMax}}" min="0"></label>
      <label data-tooltip="Blank = from level and Chakra Die">CP max <input type="number" name="system.cpMax" value="{{npc.cpMax}}" min="0"></label>
      <label data-tooltip="Used only to work out HP max">Hit Die <input type="text" name="system.hitDie" value="{{npc.hitDie}}"></label>
      <label data-tooltip="Used only to work out CP max">Chakra Die <input type="text" name="system.chakraDie" value="{{npc.chakraDie}}"></label>
    </div>
    <div class="build-abilities">
      {{#each scores}}<label data-tooltip="{{label}}">{{abbr}} <input type="number" name="system.abilities.{{key}}.value" value="{{value}}" min="0" max="30"><span class="final">{{mod}}</span></label>{{/each}}
    </div>
  {{/unless}}
  {{#if isGM}}
    <div class="build-row gm-tools">
      <button type="button" data-action="npcLeaveLoot"><i class="fa-solid fa-sack-dollar"></i> Leave loot</button>
    </div>
  {{/if}}
  {{#if vm.concept}}<div class="build-concept"><b>Concept</b> (GM only): {{vm.concept}}</div>{{/if}}
  <div class="build-row">
    {{#if editable}}<button type="button" data-action="npcOpenBuilder"><i class="fa-solid fa-user-ninja"></i> Open builder</button>{{/if}}
    <label>Build <select name="system.details.build" {{#unless editable}}disabled{{/unless}}>{{#each vm.buildOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    {{#unless vm.isAdversary}}<span class="hint">Player-style: the numbers come from ability scores, level, dice and equipment, as for a character.</span>{{/unless}}
  </div>
  {{#if vm.isAdversary}}
    {{#each vm.warnings}}<div class="build-note">{{this}}</div>{{/each}}
    <div class="section-head"><h2>Profile</h2></div>
    <div class="build-grid">
      <label>Level <input type="number" name="system.details.level" value="{{vm.level}}" min="1" max="30"></label>
      <label>Class <select name="system.details.class">{{#each vm.classOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Role <select name="system.details.role">{{#each vm.roleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Rank <select name="system.details.rank">{{#each vm.rankOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Clan or species <input type="text" name="system.details.clan" value="{{vm.clan}}"></label>
      <label>Affiliation <input type="text" name="system.details.affiliation" value="{{vm.affiliation}}"></label>
      <label>Armor <select name="system.adversary.armor">{{#each vm.armorOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>HP and CP from <select name="system.adversary.hpSource">{{#each vm.hpSourceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="check"><input type="checkbox" name="system.details.iconic" {{#if vm.iconic}}checked{{/if}}> Iconic</label>
      <label class="check"><input type="checkbox" name="system.details.epic" {{#if vm.epic}}checked{{/if}}> Epic</label>
      <label class="check" data-tooltip="Suggested ability points equal to Rank: D 1, C 2, B 3, A 4, S 5"><input type="checkbox" name="system.adversary.rankBonus" {{#if vm.rankBonus}}checked{{/if}}> Rank bonus</label>
      {{#if vm.showPartySize}}
        {{#if vm.partyManual}}<label>Players <input type="number" name="system.adversary.partySize" value="{{vm.partySize}}" min="0" max="12"></label>
        {{else}}<span class="hint">Party size: {{vm.players}} (counted; a rule setting switches to typing it here)</span>{{/if}}
      {{/if}}
    </div>

    <div class="section-head"><h2>Ability modifiers</h2>
      <span class="budget {{#if vm.overBudget}}over{{/if}} {{#if vm.underBudget}}under{{/if}}" data-tooltip="{{vm.budgetParts}}">Assigned {{vm.assigned}} of {{vm.budget}}</span>
    </div>
    <div class="hint">Baseline line for this level and class: <b>{{vm.statLine}}</b>{{#if vm.statLineMissing}} (no Elite/Solo line at this level; the Standard line is shown){{/if}}. Assign and adjust as the adversary needs.
      {{#if editable}}<button type="button" data-action="npcApplyStatLine" data-tooltip="Sets the six modifiers to the baseline line, highest to lowest in the order shown">Use baseline</button>{{/if}}</div>
    <div class="build-abilities">
      {{#each vm.abilities}}
        <label data-tooltip="{{label}}">{{abbr}} <input type="number" name="system.adversary.mods.{{key}}" value="{{assigned}}" min="-5" max="20"><span class="final">{{final}}</span></label>
      {{/each}}
    </div>

    <div class="section-head"><h2>Saves</h2>
      <span class="budget">{{vm.fullCount}} fully proficient; baseline {{vm.fullSuggested}}{{#unless vm.savesPicked}} (highest modifiers){{/unless}}</span>
    </div>
    {{#if vm.autoFailSaves}}<div class="build-note">Minion: saving throws fail automatically.</div>{{/if}}
    <table class="build-table">
      <thead><tr><th>Save</th><th>Full</th><th>Total</th><th>Baseline</th><th>Override</th></tr></thead>
      <tbody>
        {{#each vm.saves}}
          <tr>
            <td>{{label}}</td>
            <td><input type="checkbox" data-action="npcToggleFullSave" data-key="{{key}}" {{#if full}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} aria-label="{{label}} fully proficient"></td>
            <td data-tooltip-html="{{tip}}"><b>{{final}}</b></td>
            <td>{{#if overridden}}{{baseline}}{{/if}}</td>
            <td><input type="number" name="{{path}}" value="{{stated}}" placeholder="—"></td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="section-head"><h2>Statistics</h2></div>
    <table class="build-table">
      <thead><tr><th>Statistic</th><th>Total</th><th>Baseline</th><th>Override</th></tr></thead>
      <tbody>
        {{#each vm.stats}}
          <tr><td>{{label}}</td><td data-tooltip-html="{{tip}}"><b>{{final}}</b></td><td>{{#if overridden}}{{baseline}}{{/if}}</td>
            <td><input type="number" name="{{path}}" value="{{stated}}" placeholder="—"></td></tr>
        {{/each}}
      </tbody>
    </table>

    <div class="section-head"><h2>Attack bonuses and save DCs</h2>
      <label>Weapon/Freeform ability <select name="system.adversary.freeformAbility">{{#each vm.freeformOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>
    <table class="build-table">
      <thead><tr><th></th><th>Attack</th><th>Override</th><th>Save DC</th><th>Override</th></tr></thead>
      <tbody>
        {{#each vm.lines}}
          <tr><td>{{label}}</td>
            <td data-tooltip-html="{{attack.tip}}"><b>{{attack.final}}</b>{{#if attack.overridden}} <span class="was">({{attack.baseline}})</span>{{/if}}</td>
            <td><input type="number" name="{{attack.path}}" value="{{attack.stated}}" placeholder="—"></td>
            <td data-tooltip-html="{{dc.tip}}"><b>{{dc.final}}</b>{{#if dc.overridden}} <span class="was">({{dc.baseline}})</span>{{/if}}</td>
            <td><input type="number" name="{{dc.path}}" value="{{dc.stated}}" placeholder="—"></td></tr>
        {{/each}}
      </tbody>
    </table>

    <div class="section-head"><h2>Skills</h2><span class="budget">A skill that isn't trained rolls its ability modifier alone.</span></div>
    <table class="build-table skills">
      <thead><tr><th>Skill</th><th>Trained</th><th>Total</th><th>Override</th></tr></thead>
      <tbody>
        {{#each vm.skills}}
          <tr><td>{{label}}</td>
            <td><input type="checkbox" data-action="npcToggleSkill" data-key="{{key}}" {{#if proficient}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} aria-label="{{label}} trained"></td>
            <td data-tooltip-html="{{tip}}"><b>{{total}}</b></td>
            <td><input type="number" name="system.adversary.overrides.skills.{{key}}" value="{{stated}}" placeholder="—"></td></tr>
        {{/each}}
      </tbody>
    </table>

    <div class="section-head"><h2>Suggested for this class and level</h2></div>
    <div class="build-suggested">
      <span><b>{{vm.suggested.traits}}</b> traits</span><span><b>{{vm.suggested.jutsu}}</b> jutsu known</span>
      <span><b>{{vm.suggested.freeformSlots}}</b> Freeform slots</span><span><b>{{vm.suggested.multiattack}}</b> attacks with Multiattack</span>
    </div>
  {{/if}}

  {{!-- NPC1c A1-A4: both builds. Sets are edited with buttons so no field appears twice in the form. --}}
  <div class="section-head"><h2>Defenses, senses and movement</h2></div>
  <div class="build-sets">
    {{#each defenses.sets}}
      <div class="build-set" data-field="{{field}}">
        <span class="lbl">{{label}}</span>
        {{#each chips}}<span class="chip">{{label}}{{#if @root.editable}} <button type="button" class="chip-x" data-action="npcRemoveTrait" data-field="{{../field}}" data-key="{{key}}" aria-label="Remove {{label}}">×</button>{{/if}}</span>{{else}}<span class="hint">None</span>{{/each}}
        {{#if @root.editable}}
          <select data-n5e-trait-pick aria-label="Add to {{label}}"><option value="">Add…</option>{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
          {{#if custom}}<input type="text" data-n5e-trait-custom placeholder="Other" aria-label="Other language">{{/if}}
          <button type="button" data-action="npcAddTrait" data-field="{{field}}">Add</button>
        {{/if}}
      </div>
    {{/each}}
  </div>
  <div class="build-grid">
    <label>Size <select name="system.traits.size">{{#each defenses.sizeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    {{#each defenses.speeds}}<label>{{label}} <input type="number" name="system.traits.speed.{{key}}" value="{{value}}" min="0" step="5"> ft</label>{{/each}}
    <label class="check"><input type="checkbox" name="system.traits.speed.hover" {{#if defenses.hover}}checked{{/if}}> Hover</label>
  </div>
  <div class="build-grid">
    {{#each defenses.senses}}<label>{{label}} <input type="number" name="system.traits.senses.{{key}}" value="{{value}}" min="0" step="5"> ft</label>{{/each}}
  </div>
  <div class="build-grid">
    <label class="check" data-tooltip="On: the creature dies at 0 Hit Points. Off: it makes death saves like a character."><input type="checkbox" name="system.diesAtZero" {{#if defenses.diesAtZero}}checked{{/if}}> Dies at 0 Hit Points</label>
    <label class="check" data-tooltip="A player-controlled summon or ally: its owner acts with it, and it counts as an ally of the party."><input type="checkbox" name="system.allied" {{#if defenses.allied}}checked{{/if}}> Allied</label>
  </div>

  {{!-- NPC1c C3: situational skill bonuses, offered unticked in that skill's roll dialog. --}}
  <div class="section-head"><h2>Situational skill bonuses</h2><span class="budget">Offered in the roll dialog for that skill; the roller ticks them when they apply.</span></div>
  <table class="build-table">
    <thead><tr><th>Skill</th><th>Bonus</th><th>When</th><th></th></tr></thead>
    <tbody>
      {{#each defenses.situational}}
        <tr>
          <td><select name="system.situational.{{i}}.skill">{{#each skillOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></td>
          <td><input type="number" name="system.situational.{{i}}.value" value="{{value}}"></td>
          <td><input type="text" name="system.situational.{{i}}.when" value="{{when}}" placeholder="in forests"></td>
          <td>{{#if @root.editable}}<button type="button" data-action="npcRemoveSituational" data-index="{{i}}" aria-label="Remove">×</button>{{/if}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if editable}}<button type="button" data-action="npcAddSituational">Add a situational bonus</button>{{/if}}

  {{!-- NPC1c C4: what the players can learn through Read the Enemy (King Q-N21-Q-N24). --}}
  <div class="section-head"><h2>What the players can learn</h2><span class="budget">{{knowledge.learnedCount}} known to the party</span></div>
  <div class="learn-drop" data-n5e-learn-drop>
    {{#each knowledge.entries}}
      <div class="learn-entry {{#if learned}}learned{{/if}} {{#if missing}}missing{{/if}}">
        <span class="kind">{{kindLabel}}</span>
        <b>{{label}}</b>
        {{#if note}}<span class="note">{{note}}</span>{{/if}}
        {{#if @root.editable}}
          <input type="text" name="system.knowledge.entries.{{i}}.note" value="{{note}}" placeholder="Note for the players (optional)" aria-label="Note">
          <button type="button" data-action="npcToggleLearned" data-id="{{id}}" aria-pressed="{{learned}}">{{#if learned}}Known{{else}}Not known{{/if}}</button>
          {{#unless first}}<button type="button" data-action="npcMoveKnowledge" data-index="{{i}}" data-dir="-1" aria-label="Move up">↑</button>{{/unless}}
          {{#unless last}}<button type="button" data-action="npcMoveKnowledge" data-index="{{i}}" data-dir="1" aria-label="Move down">↓</button>{{/unless}}
          <button type="button" data-action="npcRemoveKnowledge" data-index="{{i}}" aria-label="Remove">×</button>
        {{/if}}
      </div>
    {{else}}
      <div class="hint">Drag features, traits, jutsu or items from this sheet here, or add a statistic or a note below.</div>
    {{/each}}
  </div>
  {{#if editable}}
    <div class="build-row">
      <select data-n5e-learn-stat aria-label="Statistic"><option value="">Statistic…</option>{{#each knowledge.statOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
      <button type="button" data-action="npcAddKnowledge" data-kind="stat">Add statistic</button>
      <input type="text" data-n5e-learn-text placeholder="A note (a weakness, a secret)" aria-label="Note">
      <button type="button" data-action="npcAddKnowledge" data-kind="text">Add note</button>
    </div>
  {{/if}}
</section>
