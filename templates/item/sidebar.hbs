<aside class="n5e-item-side">
  {{#if vm.chips.length}}
    <div class="chips">{{#each vm.chips}}<span class="chip {{tone}}" {{#if tooltip}}data-tooltip-html="{{tooltip}}"{{/if}}>{{label}}</span>{{/each}}</div>
  {{/if}}
  <dl class="facts">
    {{#each vm.facts}}<dt>{{label}}</dt><dd>{{value}}</dd>{{/each}}
  </dl>
</aside>
