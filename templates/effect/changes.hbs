{{!-- Effect editor, Changes tab (UX1; docs/UX1_SPEC.md). View model: view-models/effect-editor.mjs. --}}
<section class="tab changes n5e-effect-authoring{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <p class="hint">Add what this effect changes, then press Save effect. Closing without saving discards your edits.</p>

  {{#if editable}}
  <fieldset class="n5e-field-browser"><legend>Add a field</legend>
    <label class="wide">Search<input type="search" data-field-search placeholder="Damage reduction, speed, unarmed, mastery…"></label>
    <label class="wide">Field
      <select data-field-picker>
        {{#each pickerGroups}}<optgroup label="{{category}}">{{#each fields}}<option value="{{key}}" data-search="{{search}}" data-what="{{what}}" data-enter="{{enter}}" data-example="{{example}}" data-stacks="{{stacks}}">{{name}}</option>{{/each}}</optgroup>{{/each}}
      </select>
    </label>
    <div class="n5e-about" data-field-about aria-live="polite">
      <b data-about-name></b>
      <ul>
        <li><span class="lbl">What it does:</span> <span data-about-what></span></li>
        <li><span class="lbl">What to enter:</span> <span data-about-enter></span> <span class="sub">Example: <code data-about-example></code></span></li>
        <li><span class="lbl">Stacking:</span> <span data-about-stacks></span></li>
      </ul>
    </div>
    <div class="n5e-browser-actions">
      <button type="button" data-action="addField"><i class="fa-solid fa-plus"></i> Add this field</button>
      <select data-preset aria-label="Quick add">{{#each presets}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
      <button type="button" data-action="preset">Quick add</button>
    </div>
  </fieldset>
  {{/if}}

  <h3 class="n5e-effect-h">What it changes</h3>
  <ol data-changes class="n5e-change-cards">
    {{#each changeCards as |c|}}
    <li class="n5e-change-card {{#if c.blocking}}bad{{/if}}" data-index="{{c.i}}">
      <div class="n5e-change-top">
        <b class="n5e-change-name">{{c.name}}</b>{{#if c.category}}<span class="sub">{{c.category}}</span>{{/if}}
        {{#if @root.editable}}<button type="button" class="icon" data-action="deleteChange" aria-label="Remove {{c.name}}" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </div>
      <label class="n5e-change-value"><span class="lbl">Value</span>
        {{#if (n5eEq c.input "select")}}
          <select name="changes.{{c.i}}.value" aria-label="{{c.name}} value">{{#each c.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{else}}
          <input name="changes.{{c.i}}.value" value="{{c.value}}" aria-label="{{c.name}} value" placeholder="{{c.example}}">
        {{/if}}
        {{#if c.enter}}<span class="sub">{{c.enter}}</span>{{/if}}
      </label>
      <p class="n5e-row-problem" data-row-problem="{{c.i}}" role="status">{{c.problem}}</p>
      <details class="n5e-mini"><summary>What this does</summary>
        <p>{{c.what}}</p>{{#if c.stacks}}<p class="sub">{{c.stacks}}</p>{{/if}}
      </details>
      <details class="n5e-mini"><summary>Advanced</summary>
        <label>Stored key<input name="changes.{{c.i}}.key" value="{{c.key}}" data-change-key aria-label="{{c.name}} stored key" placeholder="n5e.dr"></label>
        {{#if c.custom}}
          <input type="hidden" name="changes.{{c.i}}.mode" value="{{c.fixedMode}}" data-dtype="Number">
          <input type="hidden" name="changes.{{c.i}}.priority" value="{{c.priority}}" data-dtype="Number">
          <p class="sub">N5e fields always add, so they have no mode or priority.</p>
        {{else}}
          <label>Mode<select name="changes.{{c.i}}.mode" data-dtype="Number">{{#each c.modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Priority<input type="number" name="changes.{{c.i}}.priority" value="{{c.priority}}" data-dtype="Number" placeholder="Auto"></label>
          <p class="sub">Mode decides how the value combines with the creature's own; higher priority applies later.</p>
        {{/if}}
      </details>
    </li>
    {{else}}<li class="hint">Nothing yet. Pick a field above and press Add this field.</li>{{/each}}
  </ol>
  <div data-editor-status class="n5e-effect-status" role="status" aria-live="polite"></div>

  <details class="n5e-section" {{#if ruleRows.length}}open{{/if}}>
    <summary>Roll rules</summary>
    <p class="hint">Advantage, bonuses or extra damage that apply only to some rolls or in some situations. Each rule reads as a sentence below its settings.</p>
    <ol class="n5e-rule-rows">
      {{#each ruleRows as |r|}}
      <li class="n5e-rule-row" data-rule-index="{{r.i}}">
        <p class="n5e-rule-sentence"><i class="fa-solid fa-dice-d20"></i> {{r.sentence}}</p>
        <input type="hidden" name="n5eRules.{{r.i}}.orig" value="{{r.raw}}">
        {{#if r.custom}}
          <p class="sub">{{r.what}}</p>
          <input type="hidden" name="n5eRules.{{r.i}}.kind" value="custom">
        {{else}}
        <div class="n5e-rule-grid">
          <label>Kind<select name="n5eRules.{{r.i}}.kind" data-rerender>{{#each r.kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Applies to<select name="n5eRules.{{r.i}}.base" data-rerender>{{#each r.bases}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#if r.needs.value}}<label>Value<input name="n5eRules.{{r.i}}.value" value="{{r.value}}" placeholder="2"></label>{{/if}}
          {{#if r.needs.formula}}<label>Dice<input name="n5eRules.{{r.i}}.formula" value="{{r.formula}}" placeholder="1d6"></label>{{/if}}
          {{#if r.needs.damageType}}<label>Damage type<select name="n5eRules.{{r.i}}.damageType">{{#each r.damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if r.needs.mode}}<label>Keep<select name="n5eRules.{{r.i}}.mode">{{#each r.rerollModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if r.needs.pool}}<label>Resource<input name="n5eRules.{{r.i}}.pool" value="{{r.pool}}" placeholder="fury"></label>{{/if}}
          {{#if r.needs.amount}}<label>Amount<input name="n5eRules.{{r.i}}.amount" value="{{r.amount}}" placeholder="1"></label>{{/if}}
          {{#if r.needs.condition}}<label>Condition<select name="n5eRules.{{r.i}}.condition">{{#each r.conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if r.needs.ranks}}<label>Ranks<input name="n5eRules.{{r.i}}.ranks" value="{{r.ranks}}" placeholder="1"></label>{{/if}}
          {{#if r.needs.who}}<label>On<select name="n5eRules.{{r.i}}.who">{{#each r.whoOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if r.needs.text}}<label class="wide">Note<input name="n5eRules.{{r.i}}.text" value="{{r.text}}"></label>{{/if}}
        </div>
        {{!-- LEFT1 P2: click-to-build conditions: each line is a fact; "Only when" all must hold, "Or when" any one, "Unless" none. --}}
        <input type="hidden" name="n5eRules.{{r.i}}.condsKeep" value="{{#if r.condsKeep}}true{{else}}false{{/if}}">
        {{#if r.condsKeep}}<p class="sub">Its conditions are nested: edit them as JSON under Advanced.</p>
        {{else}}
        <div class="n5e-conds">
          {{#each r.condRows as |c|}}
            <div class="n5e-cond {{#if c.blank}}blank{{/if}}">
              {{#unless c.blank}}<select name="n5eRules.{{r.i}}.conds.{{c.j}}.group" aria-label="How this condition counts">{{#each c.groups}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{else}}<input type="hidden" name="n5eRules.{{r.i}}.conds.{{c.j}}.group" value="all">{{/unless}}
              <select name="n5eRules.{{r.i}}.conds.{{c.j}}.fact" data-rerender aria-label="Condition">{{#each c.facts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{#if c.choices}}<select name="n5eRules.{{r.i}}.conds.{{c.j}}.detail" aria-label="Which">{{#each c.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{else if c.param}}<input name="n5eRules.{{r.i}}.conds.{{c.j}}.detail" value="{{c.detail}}" placeholder="{{c.param}}" aria-label="Which">
              {{else}}<input type="hidden" name="n5eRules.{{r.i}}.conds.{{c.j}}.detail" value="">{{/if}}
              {{#unless c.blank}}{{#if @root.editable}}<button type="button" class="icon-btn" data-action="deleteCond" data-rule="{{r.i}}" data-cond="{{c.j}}" aria-label="Remove this condition"><i class="fa-solid fa-xmark"></i></button>{{/if}}{{/unless}}
            </div>
          {{/each}}
        </div>
        {{/if}}
        {{#if r.detailOptions}}
          <fieldset class="n5e-rule-details"><legend>Only these (none ticked: all)</legend>
            {{#each r.detailOptions}}<label class="check"><input type="checkbox" name="n5eRules.{{r.i}}.details.{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
          </fieldset>
        {{/if}}
        <p class="sub">{{r.what}}</p>
        <details class="n5e-mini"><summary>Limits and timing</summary>
          <div class="n5e-rule-grid">
            <label>Whose rolls<select name="n5eRules.{{r.i}}.direction">{{#each r.directions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>Trigger<select name="n5eRules.{{r.i}}.on">{{#each r.triggers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>Uses<input type="number" min="0" max="99" name="n5eRules.{{r.i}}.uses" value="{{r.uses}}" placeholder="unlimited"></label>
            <label class="check"><input type="checkbox" name="n5eRules.{{r.i}}.oncePerTurn" {{#if r.oncePerTurn}}checked{{/if}}> Once per turn</label>
            <label class="check"><input type="checkbox" name="n5eRules.{{r.i}}.endsOnUse" {{#if r.endsOnUse}}checked{{/if}}> Ends when used</label>
            <label>Label in chat<input name="n5eRules.{{r.i}}.label" value="{{r.label}}" placeholder="the effect's name"></label>
          </div>
        </details>
        {{/if}}
        <details class="n5e-mini"><summary>Advanced: edit as JSON</summary>
          <textarea name="n5eRules.{{r.i}}.raw" rows="4" spellcheck="false" aria-label="Rule {{r.i}} JSON">{{r.raw}}</textarea>
          <p class="sub">Editing this replaces the settings above when you save.</p>
        </details>
        {{#if @root.editable}}<button type="button" data-action="deleteRule"><i class="fa-solid fa-trash"></i> Remove rule</button>{{/if}}
      </li>
      {{/each}}
    </ol>
    {{#if editable}}<button type="button" data-action="addRule"><i class="fa-solid fa-plus"></i> Add rule</button>{{/if}}
    <label class="check"><input type="checkbox" name="n5eEditor.applyTo" {{#if guidance.applyTo}}checked{{/if}}> Only on the action it's chosen for</label>
    <p class="sub">Tick this for an action effect: its rules go onto that action's card instead of applying to the creature.</p>
  </details>

  <details class="n5e-section">
    <summary>When this effect works</summary>
    <p class="hint">Limit it to some character levels or a stance. Outside them it switches off; it isn't deleted.</p>
    <div class="n5e-effect-fields">
      <label>From level (0 = any)<input name="n5eEditor.min" type="number" min="0" step="1" value="{{guidance.min}}"></label>
      <label>Up to level (0 = any)<input name="n5eEditor.max" type="number" min="0" step="1" value="{{guidance.max}}"></label>
      <label>Only in a stance of this kind<input name="n5eEditor.stance" value="{{guidance.stance}}" placeholder="taijutsu"></label>
      <label>Ends on the source's turn<select name="n5eEditor.expires">{{selectOptions expirationChoices selected=guidance.expires}}</select></label>
    </div>
    <details class="n5e-mini"><summary>Advanced</summary>
      <div class="n5e-effect-fields">
        <label>Exclusive group<input name="n5eEditor.exclusive" value="{{guidance.exclusive}}" placeholder="surge"></label>
        <label>Named state<input name="n5eEditor.state" value="{{guidance.state}}" placeholder="crash"></label>
        <label>Source creature (UUID)<input name="n5eEditor.sourceUuid" value="{{guidance.sourceUuid}}" placeholder="Actor.…"></label>
      </div>
      <p class="sub">Exclusive group: starting one effect of the group ends the others. Named state: a name other rules check, such as crash.</p>
    </details>
  </details>

  <details class="n5e-section">
    <summary>Preview</summary>
    <p class="hint">What this effect would change on the creature right now. Save to apply it for real.</p>
    <pre data-preview tabindex="0" aria-label="Effect preview"></pre>
  </details>

  <details class="n5e-section">
    <summary>Copy and share</summary>
    <p class="hint">Export this effect to a file, import one, or make a switched-off copy to experiment with.</p>
    <div class="n5e-effect-tools"><button type="button" data-action="exportEffect">Export</button>
    {{#if editable}}<button type="button" data-action="importEffect">Import</button><button type="button" data-action="duplicateEffect">Make a copy</button>{{/if}}</div>
    <details class="n5e-mini"><summary>Advanced: the effect's data</summary>
      <textarea data-raw rows="9" readonly spellcheck="false" aria-label="Read-only effect data">{{raw}}</textarea>
    </details>
  </details>

  <details class="n5e-section">
    <summary>Automation (GM)</summary>
    <p class="hint">End the effect on an event, run an approved world macro, or change how the token looks. Most effects don't need this.</p>
    <details class="n5e-mini"><summary>How to write it</summary>
      <ul class="sub">
        <li>End on an event: <code>{"expiration":[{"event":"damageTaken","count":1}]}</code></li>
        <li>Run a macro: <code>{"macros":[{"event":"apply","uuid":"Macro.ID"}]}</code> (the GM must approve it)</li>
        <li>Events: apply, remove, enable, disable, turnStart, turnEnd, combatEnd, damageTaken, successfulHit, rest.</li>
      </ul>
    </details>
    <textarea name="n5eEditor.services" rows="6" spellcheck="false" aria-label="Automation JSON">{{guidance.services}}</textarea>
    {{#if canApproveMacros}}<button type="button" data-action="approveMacros">Approve saved macros</button>{{/if}}
    <details class="n5e-mini"><summary>Timing details</summary>
      <pre tabindex="0" aria-label="Effect timing">{{timing}}</pre>
    </details>
  </details>
</section>
