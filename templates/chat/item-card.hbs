<div class="n5e-card">
  <header>
    <img src="{{img}}" alt="" width="36" height="36">
    <div><h3>{{#if glyph}}<span class="glyph">{{{glyph}}}</span>{{/if}}{{name}}</h3><span class="sub">{{subtitle}}</span></div>
  </header>
  {{#if chips.length}}<div class="chips">{{#each chips}}<span class="chip {{tone}}" data-tooltip-html="{{tooltip}}">{{label}}</span>{{/each}}</div>{{/if}}
  {{#if stats.length}}<dl class="stats">{{#each stats}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>{{/if}}
  <div class="desc">{{{description}}}</div>
  {{#each blocks}}<div class="block"><b>{{label}}</b>{{{html}}}</div>{{/each}}
  {{{acts}}}
</div>
