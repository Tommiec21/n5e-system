{{!-- N5e Compendium Browser, results (applications/browser/compendium-browser.mjs).
      Context: rows [{uuid, name, img, detail}], total, more, canAdd. Rows are draggable onto sheets. --}}
<div class="browser-main">
  <div class="summary">{{total}} found{{#if more}} · showing the first {{rows.length}}{{/if}} · drag a row onto a sheet</div>
  <ol class="results">
    {{#each rows}}
      <li class="b-row" data-uuid="{{uuid}}" draggable="true">
        <img src="{{img}}" alt="" width="32" height="32">
        <div class="b-name"><a data-action="open">{{name}}</a><span class="sub">{{detail}}</span></div>
        {{#if @root.canAdd}}<button type="button" data-action="add" data-tooltip="Add to your character / selected token"><i class="fa-solid fa-plus"></i></button>{{/if}}
      </li>
    {{else}}
      <li class="empty">Nothing matches.</li>
    {{/each}}
  </ol>
  {{#if more}}<button type="button" data-action="more">Show more</button>{{/if}}
</div>
