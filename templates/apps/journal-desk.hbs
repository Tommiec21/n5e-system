<section class="jd-shell">
  <header class="jd-toolbar"><div class="jd-brand"><strong><img class="jd-leaf" src="systems/n5e/assets/journal/leaf.svg" alt="Hidden Leaf emblem"> Journal Desk</strong><small>N5e · GM writing workspace</small></div><button type="button" data-action="library" aria-expanded="{{showLibrary}}">Library</button><select name="kind" aria-label="New entry type">{{#each kinds}}<option value="{{this}}">{{this}}</option>{{/each}}</select><button type="button" data-action="create">New entry</button><div class="jd-search"><input name="search" type="search" value="{{query}}" placeholder="Search library…" aria-label="Search library"><button type="button" data-action="search" aria-label="Search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button></div>{{#if draft}}<button type="submit" class="jd-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save</button>{{/if}}<button type="button" data-action="ideas" aria-expanded="{{showIdeas}}">Ideas</button></header>
  <div class="jd-layout {{#if showIdeas}}with-ideas{{/if}} {{#unless showLibrary}}without-library{{/unless}}">
    {{#if showLibrary}}<nav class="jd-library" aria-label="Workspace library">
      <h2 class="jd-library-title"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Library</h2>
      <details class="jd-library-options"><summary>Filter & import</summary><label>Campaign<select name="campaignFilter"><option value="">All campaigns</option>{{#each filters}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button type="button" data-action="filter">Filter library</button>
      <button type="button" data-action="starter">Import Part I starter entries</button></details>
      {{#each libraryGroups}}<details class="jd-library-group" open><summary><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{name}}</summary>{{#each entries}}<button type="button" class="jd-entry {{#if active}}active{{/if}}" aria-current="{{#if active}}page{{else}}false{{/if}}" data-action="open" data-uuid="{{uuid}}"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>{{name}}</span></button>{{/each}}</details>{{else}}<p>No matching entries. Clear your filters or create a new entry.</p>{{/each}}
    </nav>{{/if}}
    <main class="jd-main">
      <div class="jd-navigation"><nav class="jd-history" aria-label="Entry history"><button type="button" data-action="back" {{#unless canBack}}disabled{{/unless}} aria-label="Back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button><button type="button" data-action="forward" {{#unless canForward}}disabled{{/unless}} aria-label="Forward"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></nav>
      <nav class="jd-tabs" aria-label="Open entries">{{#each tabs}}<span class="{{#if active}}active{{/if}}"><button type="button" data-action="open" data-uuid="{{uuid}}">{{name}}{{#if dirty}} •{{/if}}</button><button type="button" data-action="closeTab" data-uuid="{{uuid}}" aria-label="Close {{name}}">×</button></span>{{/each}}</nav></div>
      {{#if draft}}
      <div class="jd-heading"><i class="fa-solid fa-scroll jd-document-icon" aria-hidden="true"></i><input name="name" aria-label="Entry title" value="{{draft.name}}"><button type="button" data-action="favorite" aria-label="Toggle favorite" aria-pressed="{{favorite}}"><i class="{{#if favorite}}fa-solid{{else}}fa-regular{{/if}} fa-star" aria-hidden="true"></i></button><span class="jd-save-state" data-save-state aria-live="polite">{{#if dirty}}Unsaved changes{{else}}Saved{{/if}}</span></div>
      <div class="jd-metadata"><label><i class="fa-solid fa-book-open" aria-hidden="true"></i> Campaign<select name="campaignUuid"><option value="">No campaign</option>{{#each campaigns}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><span class="jd-kind">{{draft.kind}}</span></div>
      <prose-mirror name="content" value="{{draft.content}}"></prose-mirror>
      <details class="jd-links" open><summary>Linked entries <small>({{linked.length}})</small></summary>
        {{#each linked}}<div class="jd-link-row"><span class="jd-link-label">{{label}}</span><button type="button" data-action="follow" data-uuid="{{uuid}}" {{#if missing}}disabled{{/if}}>{{name}}</button><button type="button" data-action="unlink" data-uuid="{{uuid}}" aria-label="Remove link to {{name}}">Remove</button></div>{{/each}}
        <details class="jd-link-edit"><summary>Add a relationship</summary><label>Choose a record<select name="linkRecord"><option value="">Select a record</option>{{#each records}}<option value="{{uuid}}">{{name}} · {{kind}}</option>{{/each}}</select></label><details><summary>Link another Foundry document</summary><label>Document UUID<input name="linkUuid" placeholder="Paste a document UUID"></label></details><label>Relationship<input name="linkLabel" placeholder="Client, location, related mission…"></label><button type="button" data-action="link">Add link</button><p>Links and campaign changes are saved with the entry.</p></details>
      </details>
      <details class="jd-entry-options"><summary>Entry tools</summary><button type="button" class="jd-template" data-action="template">{{#if isCharacter}}Append character profile headings{{else}}Append starter headings{{/if}}</button>
      <details><summary>GM tools</summary><div class="jd-tool-row"><button type="button" data-action="missionBudget">Mission budget</button><button type="button" data-action="adversary">Build adversary</button><button type="button" data-action="social">Social encounter</button></div><p>A linked mission budget opens directly; otherwise a new unsaved plan opens. Save it there, then link it through Linked records. Social encounters use the NPC token selected on the canvas.</p></details>
      </details><footer><button type="button" data-action="access">Player access…</button><button type="button" data-action="original">Open journal</button><button type="button" data-action="reload">Reload saved</button><button type="submit" class="jd-save">Save entry</button></footer>
      {{else}}<div class="jd-empty"><h2>A place for your next story</h2><p>Write a mission, collect a character idea, or start a campaign. Choose an entry type and select New entry.</p><p>Ideas are optional. Your writing can start with a blank page.</p></div>{{/if}}
    </main>
    {{#if showIdeas}}<aside class="jd-ideas"><h3><i class="fa-regular fa-lightbulb" aria-hidden="true"></i> Optional Ideas</h3><div class="jd-idea-filters">
      <label>Theme<select name="ideatheme"><option value="">Any theme</option>{{#each ideaOptions.theme}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
      <label>Region<select name="idearegion"><option value="">Any region</option>{{#each ideaOptions.region}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
      <label>Rank<select name="idearank"><option value="">Any rank</option>{{#each ideaOptions.rank}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><button type="button" data-action="ideaFilter">Filter ideas</button></div><p class="jd-hint">Original prompts; ranks are suggestions.</p>
      {{#each suggestions}}<article><strong>{{name}}</strong><small>{{theme}} · {{region}} · {{rank}}</small><p>{{hook}}</p><details><summary>Details</summary><p><b>Objective:</b> {{objective}}</p><p><b>Obstacle:</b> {{obstacle}}</p><p><b>Approaches:</b> {{approaches}}</p><p><b>Adversary:</b> {{adversary}}</p><p><b>Twist:</b> {{twist}}</p><p><b>Outcome:</b> {{outcome}}</p></details>{{#if ../draft}}<button type="button" data-action="ideaAppend" data-idea="{{id}}">Insert into draft</button>{{/if}}<button type="button" data-action="ideaSave" data-idea="{{id}}">Save as idea</button></article>{{else}}<p>No matching ideas. Try a wider filter.</p>{{/each}}
      <h3>Saved ideas</h3>{{#each ideas}}<article><button type="button" data-action="open" data-uuid="{{uuid}}">{{name}}</button>{{#if ../draft}}<button type="button" data-action="insert" data-uuid="{{uuid}}">Insert text</button>{{/if}}</article>{{else}}<p>Save an idea here or write your own.</p>{{/each}}</aside>{{/if}}
  </div>
</section>
