{
  "clan": "yuki",
  "spec": "docs/STD6e_SPEC.md",
  "reviewed": "2026-11-21",
  "features": {
    "yuki-bloody-mist-legacy": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "One path (the option items); switch as a Bonus action, but not back to a path already used until 10 minutes out of combat. Saves and attacks use your highest jutsu save DC and attack bonus."
        }
      ]
    },
    "yuki-bloody-mist-legacy-black-ice-mirror": {
      "status": "partial",
      "activities": [
        {
          "id": "n5erD9t4qYnZzXA6",
          "type": "save",
          "label": "Black Frost",
          "save": {
            "abilities": [
              "con"
            ],
            "dc": {
              "source": "highest"
            },
            "onSuccess": "none",
            "resave": false
          },
          "inflicts": [
            {
              "key": "yuki-frostbite",
              "kind": "condition",
              "ranks": 1,
              "label": "Frostbite"
            }
          ],
          "text": "A hostile creature destroys a mirror you occupy. Failure: Frostbite.",
          "damage": {
            "parts": []
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Black Iron Reflection: mirrors gain 5 DR against damage they aren't immune, resistant or vulnerable to. Frost Courier: a rank of Mastery on Athletics (two at 11th); an ally damaged within 10 feet of a mirror can use its reaction to exit within 5 feet of another."
        }
      ]
    },
    "yuki-bloody-mist-legacy-frost-bound-shield": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Bulwark: mirrors gain hit points equal to your level. Stalwart: in a mirror, a rank of Mastery on Strength and Dexterity saves (two at 11th); mirrors resist area damage. Black Frost: inflicting Frostbite heals all your mirrors 5."
        }
      ]
    },
    "yuki-bloody-mist-legacy-glacial-movement": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Glacial Jump: once per turn, Reflective Movement costs no movement; Mirrored Strike works with melee attacks against creatures within 15 feet of your mirror. Hostile Terrain: a rank of Mastery on initiative (two at 11th); your Hijutsu or feature difficult terrain deals 5 cold per space to hostile creatures and spares allies. Rime Line: you leave rime where you move until your next turn."
        }
      ]
    },
    "yuki-bloody-mist-legacy-hoarfrost": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Frosted Glass: while you're in a mirror, all mirrors emit a 10-foot mist; allies in it gain Mirrors Protection. Ominous Reflections: a rank of Mastery on Chakra Control (two at 11th); Suppress Chakra can make a mirror seem to hold you. Brine Prison: inflicting Frostbite turns a 10-foot radius on the creature into difficult terrain for 1 minute (not for you; fire dispels it)."
        }
      ]
    },
    "yuki-bloody-mist-legacy-refraction": {
      "status": "partial",
      "activities": [
        {
          "id": "n5endNFqLa2qVGHL",
          "type": "save",
          "label": "Frostbane",
          "save": {
            "abilities": [
              "dex"
            ],
            "dc": {
              "source": "highest"
            },
            "onSuccess": "none",
