          },
          "inflicts": [
            {
              "key": "prone",
              "kind": "state",
              "ranks": 1,
              "label": "Prone"
            }
          ],
          "text": "Inflicting Frostbite on a creature within 10 feet of a mirror. Failure: it's dragged in and expelled Prone within 5 feet of another mirror.",
          "damage": {
            "parts": []
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Double Pane: each Ice Mirror makes 2 (gain 2), immune to poison. Truth in Passing: a rank of Mastery on Investigation (two at 11th); Study takes an Action."
        }
      ]
    },
    "yuki-bloody-mist-legacy-shiver-weave": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eL6CucbawqGzGF",
