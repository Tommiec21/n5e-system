            "resave": false
          },
          "inflicts": [],
          "text": "Failure: speed 0 until the end of the turn.",
          "damage": {
            "parts": []
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Hail Burst: a rank of Mastery on Stealth (two at 11th); casting a Yuki Hijutsu, a 15-foot cube of hail from you totally obscures until your next turn. Frost Splinter: Reaction, a mirror is destroyed: teleport to another (you still take the damage)."
        }
      ]
    },
    "yuki-demonic-mirror-master": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eOBy57WnvFaubG",
          "type": "effect",
          "label": "Demonic Ice Prism",
          "effect": {
            "name": "Demonic Ice Prism",
            "target": "self",
            "changes": [],
            "expires": "",
            "seconds": 60
          },
          "text": "Bonus action on your turn, 1 minute, once per rest: up to 8 mirrors in unoccupied spaces within 60 feet (outside your limit); you teleport into the closest.",
          "activation": "bonus"
        }
      ],
      "system": {
        "uses": {
          "max": "1",
          "spent": 0,
          "per": "rest",
          "recharge": "",
          "staminaEligible": false
        }
      },
      "rules": [
        {
          "key": "note",
          "text": "Once per turn at the start of your turn, switch Bloody Mist Legacy paths freely. Ice Daggers: one attack roll against all creatures of your choice within 15 feet of a mirror."
        }
      ]
    },
