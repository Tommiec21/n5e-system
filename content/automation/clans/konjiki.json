      ],
      "rules": [
        {
          "key": "note",
          "text": "Liquid Metal Ingots: 1 + proficiency bonus, back on a short rest (the pool). One Alomancy Technique (more at 7th and 15th). Their attacks and saves use your highest jutsu attack bonus or save DC."
        }
      ]
    },
