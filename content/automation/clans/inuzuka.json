{
  "clan": "inuzuka",
  "spec": "docs/STD6e_SPEC.md",
  "reviewed": "2026-11-21",
  "features": {
    "inuzuka-beast-human-clone": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "On initiative your Nin-Dog looks exactly like you (only Chakra Sight tells you apart); it gains your Four-Legs stance and goes Feral with you."
        }
      ]
    },
    "inuzuka-beast-master": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Your Nin-Dog (breed: Inuit, Kugsha, Tamaskan, Shiba or Akita, plus a trait; +1 trait at 7th and 15th): acts on your turn with its own reaction (casting your Tag-Team Hijutsu). Commands: Move (free), Strike (forgo attacks for its Bite), Synchronize (with a Tag-Team jutsu: it casts the Tag-Team effect, spending a jutsu slot), Hunt (Bonus action: a special ability, Dash, Disengage, Hide, Help or a skill action). Jutsu slots back on any rest; at 0 it makes death saves; a Full Rest ritual replaces it. Small, Medium at 7th, Large at 15th; +1 to an ability and save at 4, 8, 12, 16, 19 (max +6). Its stat block is held for King's (H6)."
        }
      ]
    },
    "inuzuka-beast-sense": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "A rank of Mastery in Perception, Insight and Survival; their Action skill actions take a Bonus action."
        }
      ]
    },
    "inuzuka-cross-guard": {
      "status": "partial",
      "activities": [
        {
          "id": "n5ezUAispTIcgd9m",
          "type": "roll",
          "label": "Cross Guard",
          "roll": {
            "formula": "",
            "note": "Reaction: reduce the damage by [Unarmed Damage] + [Unarmed Damage] (or + [Weapon Damage]); the Nin-Dog: Bite + Bite. +1d6 per rank."
          },
          "activation": "reaction"
        }
      ]
    },
    "inuzuka-dynamic-marking": {
      "status": "partial",
      "activities": [
        {
