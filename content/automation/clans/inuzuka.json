          "label": "Dynamic Marking",
          "effect": {
            "name": "Marked (scent)",
            "target": "targets",
            "changes": [],
            "expires": "",
            "seconds": 600
          },
          "text": "Bonus action: creatures in a 10-foot cube within your Nin-Dog's movement, 10 minutes: you and the dog know their direction, blindsight against them, advantage to Search for them, +1 to hit them.",
          "activation": "bonus"
        }
      ]
    },
