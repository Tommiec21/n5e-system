          "staminaEligible": false
        }
      },
      "rules": [
        {
          "key": "note",
          "text": "Action: within 10 feet (Class & Clan Summons › Tsuchigumo); command it as a Bonus action. Dispelled or dismissed: not again until a long rest. Its Broodlings have no stat block (held, like Q-E14)."
        }
      ]
    },
    "tsuchigumo-master-silk-weaver": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "10 minutes, once per rest: a 20-foot cube traversable silk structure for 1 hour, for the creatures you name (Medium or smaller; anyone else touching it collapses it). Or over a rest: a fine garment for 24 hours (dissolves in water); unfamiliar non-hostile creatures' attitude +1 rank. (Its text also holds the Brood Mother's stat block, now the summon.)"
        }
      ]
    },
    "tsuchigumo-silk-weaves": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "After a rest prepare 2 Silk Weaves (3 at 7th, 4 at 15th): the option items. Saves use your highest jutsu save DC; one dispelling weave per turn."
        }
      ]
    },
