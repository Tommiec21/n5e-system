    "uzumaki-mutation-fundamental-technique": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Mutates Swirling Seals: a jutsu you know (not your Original Technique; without that mutation, a Hijutsu) is your Fundamental Technique (+1 at 7th and 15th); each casting gains one: Stable (if concentration), Efficient (if concentration), or the Hijutsu keyword."
        }
      ]
    },
    "uzumaki-mutation-original-technique": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Mutates Uzumaki Sealing Techniques: one B-Rank or lower jutsu becomes your Original Technique: cost by rank (D 5, C 9, B 14, A 20, S 25), cast only at the highest rank you can, fewer damage dice until it reaches its own rank (C −2, B −4, half returned per rank), the Hijutsu keyword, 2 Jutsu Creation effects (+1 at 7th and 15th; not Lasting, Upcast, Damage, Empowered Damage, Multiple Strikes, Damage Reduction, Augmentation, Unavoidable or Mind Control). Edit the jutsu with your GM. You must also take a 1st, 3rd, 11th and 15th level Uzumaki mutation."
        }
      ]
    },
