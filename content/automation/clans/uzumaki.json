    "uzumaki-adamantine-barrier": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eGhbYWksK2yGMq",
          "type": "save",
          "label": "Adamantine Barrier",
          "save": {
            "abilities": [
              "cha"
            ],
            "dc": {
              "source": "discipline"
            },
            "onSuccess": "none",
            "resave": false
          },
          "inflicts": [],
          "text": "A 15-foot radius sphere within 60 feet, concentration up to 10 minutes. A hostile creature moving through or targeting inside without permission. Failure: it can't this turn and picks a new target. Area effects pass through.",
          "damage": {
            "parts": []
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "The 5-Pronged Seal condition text printed here belongs to Uzumaki Art: 5-Pronged Seal (see the spec's text issues)."
        }
      ],
      "castOptions": [
        {
          "label": "Seal Break",
          "appliesTo": {
            "namePrefix": "Adamantine Barrier"
          },
          "note": "In your Binding Chain stance, dispel 1 rank of Sealed from a creature within 30 feet: the barrier gains temporary hit points by its rank (D 10, C 16, B 22, A 28, S 34) and takes damage meant for those inside."
        }
      ]
    },
    "uzumaki-binding-chains": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Bonus action: enter the Binding Chain stance (the clan's stance item) for 1 minute."
        }
      ]
    },
    "uzumaki-gut-feeling": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Conscious: hidden creatures can't surprise you; a rank of Mastery to initiative per surprised ally. Deception against you: your passive Insight counts 5 higher. See Through Lies uses Constitution or Charisma; beating it by 5 gains a Will of Fire (once per long rest)."
        }
      ]
    },
