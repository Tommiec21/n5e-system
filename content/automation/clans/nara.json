    "nara-mendokuse": {
      "status": "partial",
      "activities": [
        {
          "id": "n5erecMDtNDFeXTx",
          "type": "save",
          "label": "Shadow Possession (Bonus action)",
          "save": {
            "abilities": [
              "dex"
            ],
            "dc": {
              "source": "highest"
            },
            "onSuccess": "none",
            "resave": false
          },
          "inflicts": [
            {
              "key": "nara-shadow-bound",
              "kind": "condition",
              "ranks": 1,
              "label": "Shadow Bound"
            }
          ],
          "text": "A creature you can see within 40 feet (60 at 7th, 80 at 15th). Failure: Shadow Bound; it saves Strength or Dexterity at the end of each of its turns to end it. Hold 1 creature (2 at 7th, 3 at 15th). Not while you can't mold chakra or concentrate.",
          "activation": "bonus",
          "damage": {
            "parts": []
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "One Contingency at the start of your turn with no Bonus action (then you can't use the Bonus action for one). Shadow Possession as a Bonus action instead of an Action."
        }
      ]
    },
    "nara-operational-contingencies": {
      "status": "partial",
      "activities": [
        {
          "id": "n5e3AsAdWWRp8DmG",
          "type": "roll",
          "label": "Establish a Contingency",
          "roll": {
            "formula": "",
            "note": "Start of your turn, Bonus action: one Cause + one Effect (the option items) until the start of your next turn (two at 11th); the Effect happens as the Cause does."
          },
          "activation": "bonus"
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Combat Coordinated is the condition item (Team Coordination applies it)."
        }
      ]
    },
    "nara-operational-contingencies-cause": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Causes: an ally is targeted by an attack; fails a save; gains a Physical condition; gains a Mental condition; a hostile creature you see casts an HS jutsu; starts its turn concentrating; moves within 10 feet of an ally."
        }
      ]
    },
    "nara-operational-contingencies-effect": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Effects: an ally gets a rank of Mastery to AC, or to saves, until the start of its next turn; remakes its saves against current effects; makes a free opportunity attack; uses its reaction to move 10 feet without provoking (out of the area or reach: no longer a target); uses its reaction to cast a 1-Action jutsu at a hostile creature in range."
        }
      ]
    },
    "nara-shadow-arts": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Bonus action: enter the Shadow Art chakra stance (the clan's stance item). Your Hijutsu's Bright / Dimly Lit effects: cast dialog options, by the GM's time of day."
        }
      ]
    },
    "nara-shadow-gathering": {
      "status": "note",
      "activities": [],
      "rules": [
        {
          "key": "note",
          "text": "Concentration: shadow tendrils within 60 feet slip under doors and through holes to steal (up to 25 pounds), disable a device or trap, or pick a lock (roll the check)."
        }
      ]
    },
