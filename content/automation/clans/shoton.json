    "shoton-crystal-symbiosis": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Benefit from two Crystal Types at once. Casting a nature release summon jutsu (or a class feature construct): give it a Crystal Body: Amethyst (half area damage), Emerald (its jutsu gains Stable and Efficient), Jade (Action: heal allies 2d6 + your level), Onyx (interposes attacks on allies within 10 feet), Quartz (+2 AC, +1 per rank above its base), Ruby (attack damage die +1 step), Sapphire (once per turn, beating AC by 5 is a critical hit), Topaz (its Recharge use regains you 4 Hardness)."
        }
      ]
    },
    "shoton-crystals-gems-and-jewels": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "After a long rest pick 2 Crystal Types (3 at 7th, 4 at 15th): the option items; one benefits you at a time (switch at the start of your turn). Aura effects reach only creatures in your Crystal Aura. Attacks and saves use your highest jutsu attack bonus and save DC."
        }
      ]
    },
    "shoton-crystals-gems-and-jewels-amethyst-ward": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Weapon Dance: summons with your infused weapon gain temporary hit points by their rank each turn (D 4, C 8, B 12, A 16, S 20). Aura: allies gain a rank of Mastery against Mental conditions (two at 11th)."
        }
      ]
    },
    "shoton-crystals-gems-and-jewels-emerald-lattice": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Weapon Dance: a rank of Mastery on concentration for Shoton Hijutsu (two at 7th; 15th: 2 Hardness keeps a failed one). Aura: allies gain a rank of Mastery on concentration (7th: 1 Hardness adds 1d6 to their concentration or Clash check; 15th: 2 Hardness per jutsu keeps a lost one)."
        }
      ]
    },
