  "features": {
    "shoton-crown-jewels": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "10 minutes: one crystal regalia that passes as genuine (Chakra Sight or Sensing or a steady eye sees through it) for 24 hours (one at a time). Against creatures swayed by wealth or status (not high authority): the first request gets Persuasion or Intimidation at advantage, and it saves Wisdom against your result or tries to comply; restricted areas may open; first seeing the wearer it saves Wisdom against your highest jutsu save DC or is preoccupied for 1 minute and not hostile at first."
        }
      ]
    },
    "shoton-crystal-ascension": {
      "status": "partial",
      "activities": [
        {
          "id": "n5ej1kWo3VUNUCWF",
          "type": "effect",
          "label": "Crystal Ascension",
          "effect": {
            "name": "Crystal Ascension",
            "target": "self",
            "changes": [],
            "expires": "",
            "seconds": 60
          },
          "text": "Bonus action within 10 feet of your Earth jutsu or class feature summon, once per long rest: fuse into it for 1 minute (or until its 120 hit points drop to 0 or an Action ends it). Record your hit points.",
          "activation": "bonus",
          "cost": {
            "pool": "hardness",
            "amount": 4
          }
        }
      ],
      "system": {
        "uses": {
          "max": "1",
          "spent": 0,
          "per": "lr",
          "recharge": "",
          "staminaEligible": false
        }
      },
      "rules": [
        {
          "key": "note",
          "text": "Fused: 120 hit points; its size and Strength, Dexterity and Constitution, your mental scores, speed, features and Shoton Hijutsu, its attacks; both Crystal Forms, the aura +10 feet. Ending: you appear nearby and it's dispelled; leftover damage from hitting 0 carries to your recorded hit points."
        }
      ]
    },
