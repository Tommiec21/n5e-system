    "yoton-lava-chakra-mode": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Bonus action, once per Long Rest: the Lava Chakra Mode Amp for 1 minute (start it from your Amps). Or, in combat, standing in two overlapping Molten Terrains: a Bonus action dispels both and starts it (once per Long Rest that way)."
        }
      ]
    },
