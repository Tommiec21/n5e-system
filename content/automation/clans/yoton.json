    "yoton-lava-release-manifestation": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "You gain the other nature release (Earth or Fire; set it on the sheet); Earth or Fire Release jutsu can deal Earth or Fire damage respectively. 10 minutes of Magma chakra destroys a seal or barrier up to your highest rank; higher ones need an ability check (highest jutsu modifier) against their Standard Jutsu DC."
        }
      ]
    },
