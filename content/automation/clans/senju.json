          "attack": {
            "discipline": "highest",
            "range": "melee",
            "count": 1
          },
          "text": "An 8+ on the damage die: Drained (2 ranks at 7th, 3 at 15th) and push or pull 10 feet (15 at 7th). 7th: counts as casting a D-Rank Hijutsu. Earth, cold or chakra.",
          "damage": {
            "parts": [
              {
                "formula": "lvl(1:1d10,11:2d10) + max(@mod.nin, @mod.tai, @mod.gen)",
                "type": "earth"
              }
            ]
          }
        },
        {
          "id": "n5eIxmal2mNC6VhW",
          "type": "attack",
          "label": "Verdant Lash (ranged)",
          "attack": {
            "discipline": "highest",
            "range": "ranged",
            "count": 1
          },
          "text": "30 feet. An 8+ on the damage die: Drained (2 ranks at 7th, 3 at 15th) and push or pull 10 feet (15 at 7th). 7th: counts as casting a D-Rank Hijutsu. Earth, cold or chakra.",
          "damage": {
            "parts": [
              {
                "formula": "lvl(1:1d10,11:2d10)",
                "type": "earth"
              }
            ]
          }
        },
        {
          "id": "n5egS0yBlR1dtyfI",
          "type": "effect",
          "label": "Drained",
          "effect": {
            "name": "Drained",
            "target": "targets",
            "changes": [],
            "expires": "",
            "seconds": 0,
            "condition": "senju-drained"
          },
          "text": "From Verdant Lash's 8+: 1 rank (2 at 7th, 3 at 15th: apply it again)."
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "The Mokuton Infusion chakra stance, usable with a Taijutsu or Bukijutsu stance (its text is Mokuton Infusion's, as King Q-E9). Bonus action to enter or swap variants. Will of the Buddha: with a Combat Scroll, the Attack action's attacks can be Verdant Lash. Fist of Hevajra: [Unarmed Damage] cold, earth or chakra (pick when you roll); unarmed attacks can use your Hijutsu Flexibility ability; Reach 1 (Reach 2 at 7th)."
        }
      ]
    },
    "senju-verdant-bloodline": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eRvJLPG5a5UzN3",
          "type": "roll",
          "label": "New Growth",
          "roll": {
            "formula": "",
            "note": "Once per turn, with an Attack action attack in your Mokuton Infusion stance or casting a Senju Hijutsu: a 10-foot radius within 60 feet; others spend 4 feet per foot moved; 1 minute or until damage crosses it."
          },
          "oncePerTurn": true
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Drained is the condition item."
        }
      ]
    },
    "senju-verdant-domain": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Hostile creatures you choose that are Grappled or Restrained by a Senju Hijutsu, or stand in New Growth, cast CM jutsu above their rank (Standard D, Elite C, Solo B) only by gaining a rank of Drained per rank above."
        }
      ]
    },
