{
  "clan": "senju",
  "spec": "docs/STD6e_SPEC.md",
  "reviewed": "2026-11-21",
  "features": {
    "senju-blood-of-the-leaf": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "A non-allied creature in conversation makes a request of you: Intimidation in response gains 2 ranks of Mastery."
        }
      ]
    },
    "senju-built-different": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eMnl6HE6qGq2UV",
          "type": "heal",
          "label": "Senju Cell: heal",
          "heal": {
            "formula": "max(1, 1d6 + floor(@level / 2))",
            "pool": "hp"
          },
          "text": "Once per turn, start of your turn, not incapacitated.",
          "cost": {
            "pool": "senjuCells",
            "amount": 1
          },
          "oncePerTurn": true
        },
        {
          "id": "n5eJUO1iY9KjvORp",
          "type": "roll",
          "label": "Senju Cell: end a condition",
          "roll": {
            "formula": "",
            "note": "7th, start of your turn: end one Physical or Elemental condition on you."
          },
          "cost": {
            "pool": "senjuCells",
            "amount": 1
          },
          "minLevel": 7
        },
        {
          "id": "n5e3lpPWQUB44mKg",
          "type": "roll",
          "label": "Senju Cell: Hit Dice at 0",
          "roll": {
            "formula": "",
            "note": "15th, starting your turn at 0 hit points: spend Hit Dice equal to the Cells spent and regain the result (roll them)."
          },
          "cost": {
            "pool": "senjuCells",
            "choose": true
          },
          "minLevel": 15
        }
      ],
      "effects": [
        {
          "name": "Built Different",
          "changes": [
            {
              "key": "system.bonuses.hpPerLevel",
              "value": "2",
              "mode": 2
            }
          ]
        }
      ],
      "pools": [
        {
          "id": "senjuCells",
          "label": "Senju Cells",
          "value": 0,
          "max": "lvl(1:2,7:4,15:6)",
          "die": "",
          "steps": [],
          "step": 0,
          "recovery": [
            {
              "on": "rest",
              "amount": "all",
              "formula": "",
              "requires": ""
            }
          ]
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Hit points +2 per level (the effect). Senju Cells: 2 (4 at 7th, 6 at 15th; Elite Bloodline +2, +2 more at 11th: raise the pool's maximum by hand), back on a rest."
        }
      ]
    },
    "senju-mokuton-infusion": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Bonus action: enter the Mokuton Infusion stance (the clan's stance item) in one of its variants."
        }
      ]
    },
    "senju-mutation-elite-bloodline": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Mutates Verdant Bloodline: resistance to Physical and Elemental conditions; +2 Senju Cells (+2 more at 11th; raise the pool's maximum by hand)."
        }
      ]
    },
    "senju-mutation-history-of-the-elite": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eKXs0WiXe2FQAs",
          "type": "heal",
          "label": "Energizing: heal",
          "heal": {
            "formula": "lvl(1:1,7:2,15:3)d8",
            "pool": "hp"
          },
          "text": "Once per turn, Bonus action, a willing creature you touch: its Hit Dice rolled without spending them + its Constitution modifier (use its die size; twice per rest per creature).",
          "activation": "bonus"
        },
        {
          "id": "n5eaHSl4ZMrdUujo",
          "type": "roll",
          "label": "Energizing: cleanse",
          "roll": {
            "formula": "1d20 + @abilities.con.mod",
            "note": "Bonus action: the condition's check (or DC 12 Constitution) ends 1 rank, +1 per 2 over (twice per rest per creature)."
          },
          "activation": "bonus"
        },
        {
          "id": "n5eLhhC6ULEUKMoN",
          "type": "roll",
          "label": "Rallying Figure",
          "roll": {
            "formula": "",
            "note": "Reaction, you or an ally you see fails a save: it remakes it; on a success you regain 1 Senju Cell."
          },
          "activation": "reaction",
          "cost": {
            "pool": "senjuCells",
            "amount": 1,
            "gain": true
          }
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Mutates Mokuton Infusion. Two Elite Tactics (+1 at 7th and 15th): Unbreakable (a rank of Mastery on one save; repeatable); Energizing; Unfaltering (resistance to two of Burned, Chilled, Corroded, Shocked, Envenomed, Bruised, Staggered, Bleed, Dazed, Shaken, Weakened, Concussed, Exhausted; repeatable); Rallying Figure; Legacy of the Second (Water jutsu; their conditions can be Drained ranks instead); Legacy of the Fifth (the same with Medical)."
        }
      ]
    },
    "senju-mutation-prime-nature-release": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Mutates Wood Release Affinity and Mokuton Release Techniques: one release of Earth, Wind, Fire, Water, Lightning or Medical (2 jutsu of it at 1st, 3rd, 7th, 11th and 15th). You must also take a 1st, 3rd, 11th and 15th level Senju mutation."
        }
      ]
    },
    "senju-mutation-quickened-regeneration": {
      "status": "partial",
      "activities": [
        {
          "id": "n5eZiCALzHZXMHzR",
          "type": "heal",
          "label": "Quickened Regeneration",
          "heal": {
            "formula": "floor(@level / 2)",
            "pool": "hp"
          },
          "text": "Once per turn in combat, a hostile creature's damage that doesn't drop you to 0."
        }
      ],
      "rules": [
        {
          "key": "note",
          "text": "Conditions with [Persist] end after 1 minute."
        }
      ]
    },
    "senju-mutation-the-strongest-bloodline": {
      "status": "note",
      "rules": [
        {
          "key": "note",
          "text": "Mutates Wood Release: add your highest jutsu ability modifier to jutsu damage if you don't already. Once per rest, name a Rival Clan: +1 to attacks and jutsu save DC against its members."
        }
      ]
    },
